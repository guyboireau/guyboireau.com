---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

// Astro sert ce fichier pour toute URL inconnue, en statique comme en SSR.
// Sans lui, le visiteur reçoit la page par défaut de l'hébergeur : hors charte,
// en anglais, et sans aucun chemin de retour vers le site.
const title = 'Page introuvable | Guy Boireau'
const description = "Cette page n'existe pas ou a été déplacée."
---

<BaseLayout {title} {description} noindex>
  <Header />
  <main id="contenu" tabindex="-1" class="focus:outline-none">
    <section class="bg-creme pt-28 pb-24 md:pt-36 px-4 sm:px-6 lg:px-8 min-h-[70vh]">
      <div class="max-w-3xl mx-auto">
        <p class="etiquette mb-6">Erreur 404</p>
        <h1 class="text-4xl md:text-6xl mb-6">Cette page n'existe pas</h1>
        <p class="text-encre-2 leading-relaxed mb-10">
          Elle a peut-être été déplacée. Si vous êtes arrivé ici par un lien de ce site,
          <a href="/contact" class="lien">dites-le-moi</a> et je le corrigerai.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="/" class="btn-primary">Retour à l'accueil</a>
          <a href="/projets" class="btn-secondary">Les projets</a>
          <a href="/services" class="btn-secondary">Les services</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
