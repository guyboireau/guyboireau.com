---
import { anneesExperience } from '../data/experience'
import { Image } from 'astro:assets'
import portrait from '../assets/profile.jpg'
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const title = 'À propos | Guy Boireau, développeur indépendant à Bordeaux'
const description =
  "Développeur indépendant à Bordeaux. Mastère Expert en développement Web (Ynov, titre RNCP de niveau 7), trois ans d'alternance chez Bassetti sur un logiciel industriel."

const competences = [
  { titre: 'Interfaces', items: ['React', 'React Native', 'TypeScript', 'JavaScript', 'HTML et CSS', 'Vite', 'Astro'] },
  { titre: 'Serveur', items: ['NestJS', 'Node.js', 'Laravel', 'C#', '.NET', 'API REST'] },
  { titre: 'Bases de données', items: ['PostgreSQL', 'MySQL', 'MongoDB', 'Supabase', 'Prisma'] },
  { titre: 'Mise en ligne et outils', items: ['Docker', 'GitLab CI/CD', 'GitHub Actions', 'Vercel', 'Jest', 'Cypress'] },
  { titre: 'Qualité et sécurité', items: ['OWASP Top 10', 'WCAG 2.1', 'Tests unitaires', 'Swagger', 'JWT', 'Stripe'] },
]

const experiences = [
  {
    title: 'Développeur indépendant',
    company: 'Guy Boireau EI',
    period: "Depuis novembre 2025",
    description: "Applications métier, automatisation et traitement de documents. Sites pour artisans et commerces, hébergement et suivi mensuel.",
    techs: ['React', 'React Native', 'NestJS', 'Supabase', 'TypeScript', 'Astro'],
  },
  {
    title: 'Développeur intégrateur, en alternance',
    company: 'BASSETTI France',
    location: 'Bordeaux',
    period: 'Octobre 2022 à septembre 2025',
    description: "Trois ans sur TEEXMA, un logiciel de gestion de données techniques utilisé par des industriels : matériaux, essais, contrôle qualité, documentation. Recueil du besoin chez le client, développement des modules, livraison et déploiement chez lui.",
    techs: ['TEEXMA', 'Delphi', 'JavaScript', 'MySQL'],
  },
  {
    title: 'Stage de développement C#',
    company: "Cerfrance Terre d'Allier",
    location: 'Toulon-sur-Allier',
    period: 'Janvier à février 2022',
    description: 'Développement logiciel en C#, bonnes pratiques et programmation orientée objet.',
    techs: ['C#', '.NET', 'Visual Basic'],
  },
  {
    title: 'Stage de développement web',
    company: 'Technoplane',
    location: 'Moulins',
    period: 'Mai à juin 2021',
    description: 'Développement web et premières technologies front-end.',
    techs: ['HTML', 'CSS', 'JavaScript', 'PHP'],
  },
]

const formation = [
  {
    degree: 'Mastère Expert en développement Web',
    field: 'Titre RNCP de niveau 7',
    school: 'Ynov Campus Bordeaux',
    period: '2022 à 2025',
  },
  {
    degree: 'Bachelor 3',
    field: 'Développement web et mobile',
    school: 'Ynov Campus Bordeaux',
    period: '2022 à 2023',
  },
  {
    degree: 'BTS SIO, option SLAM',
    field: 'Solutions logicielles et applications métiers',
    school: 'Lycée Sidoine Apollinaire',
    period: '2020 à 2022',
  },
  {
    degree: 'Baccalauréat',
    field: 'Économie',
    school: 'Lycée Théodore de Banville',
    period: '2017 à 2020',
  },
]

const principes = [
  { titre: 'Votre métier avant la technique', texte: "Je comprends comment vous travaillez avant d'écrire la moindre ligne de code." },
  { titre: 'Un prix fixé avant de commencer', texte: 'Je chiffre au forfait. Si un imprévu change le périmètre, je vous le dis avant de continuer.' },
  { titre: 'Des livraisons par étapes', texte: 'Vous testez chaque étape. Le projet ne disparaît pas des semaines dans un tunnel.' },
  { titre: 'Je reste après la livraison', texte: "Je peux héberger et surveiller ce que j'ai construit. Vous savez qui appeler." },
]
---

<BaseLayout {title} {description}>
  <Header />
  <main id="contenu" tabindex="-1" class="focus:outline-none">
    <!-- Intro -->
    <section class="bg-creme border-b border-ligne pt-28 pb-16 md:pt-36 md:pb-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto grid gap-12 md:grid-cols-[240px_minmax(0,1fr)] md:items-start">
        <Image
          src={portrait}
          alt="Guy Boireau"
          widths={[240, 480, 720]}
          sizes="(max-width: 768px) 208px, 240px"
          format="webp"
          loading="eager"
          class="w-52 md:w-60 h-auto rounded border border-ligne"
        />

        <div class="space-y-4 text-encre-2 text-lg leading-relaxed">
          <p class="etiquette">À propos</p>
          <h1 class="text-4xl md:text-5xl leading-tight text-encre">Guy Boireau, développeur indépendant à Bordeaux</h1>
          <p>
            J'ai un Mastère Expert en développement Web (Ynov Campus Bordeaux, titre RNCP de niveau 7).
            Pendant ma formation, j'ai passé trois ans en alternance chez <strong class="text-encre font-medium">BASSETTI France</strong>,
            sur <strong class="text-encre font-medium">TEEXMA</strong>, un logiciel de gestion de données techniques pour l'industrie.
          </p>
          <p>
            J'y ai appris deux choses. Un outil métier est adopté quand il fait gagner du temps à ceux qui l'utilisent, pas parce qu'il est beau.
            Et la donnée technique arrive presque toujours sur papier ou dans un tableur : c'est ce passage du document au logiciel qui coûte le plus cher.
          </p>
          <p>
            Depuis novembre 2025, je travaille à mon compte. Je développe des applications, des automatisations et des sites, puis je les héberge et je les suis.
          </p>
          <ul class="flex flex-wrap gap-x-8 gap-y-2 font-mono text-[13px] text-encre-2 pt-4">
            <li><span data-annees-experience>{anneesExperience()}</span> ans d'expérience</li>
            <li>Mastère, titre RNCP niveau 7</li>
            <li>Bordeaux, et à distance partout en France</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Principes -->
    <section class="section">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12">
          <h2 class="section-title">Comment je travaille</h2>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {principes.map((p, index) => (
            <li class="carte p-6 apparition">
              <p class="font-mono text-[13px] font-medium text-primary-700 mb-3">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="text-xl mb-2">{p.titre}</h3>
              <p class="text-encre-2 leading-relaxed">{p.texte}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Expérience -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-4xl mx-auto">
        <div class="apparition mb-12">
          <h2 class="section-title">Expérience</h2>
        </div>

        <ol class="border-l border-ligne space-y-10">
          {experiences.map((exp) => (
            <li class="relative pl-8 apparition">
              <span class="absolute -left-[5px] top-2 w-[9px] h-[9px] rounded-full bg-primary-500" aria-hidden="true"></span>
              <p class="font-mono text-[13px] text-encre-3 mb-2">{exp.period}</p>
              <h3 class="text-2xl mb-1">{exp.title}</h3>
              <p class="text-encre font-medium mb-3">
                {exp.company}{exp.location && <span class="text-encre-2 font-normal">, {exp.location}</span>}
              </p>
              <p class="text-encre-2 leading-relaxed mb-3 max-w-2xl">{exp.description}</p>
              <p class="font-mono text-[13px] text-encre-3">{exp.techs.join(' · ')}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Compétences -->
    <section class="section">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12">
          <h2 class="section-title">Compétences techniques</h2>
        </div>

        <dl class="divide-y divide-ligne border-y border-ligne">
          {competences.map((cat) => (
            <div class="grid gap-2 md:grid-cols-[240px_minmax(0,1fr)] py-4 apparition">
              <dt class="font-display text-xl text-encre">{cat.titre}</dt>
              <dd class="font-mono text-sm text-encre-2 leading-relaxed">{cat.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Formation -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12">
          <h2 class="section-title">Formation</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {formation.map((edu) => (
            <div class="carte p-6 apparition">
              <p class="font-mono text-[13px] text-encre-3 mb-2">{edu.period}</p>
              <h3 class="text-xl mb-1">{edu.degree}</h3>
              <p class="text-primary-700 mb-1">{edu.field}</p>
              <p class="text-encre-2">{edu.school}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section">
      <div class="max-w-3xl mx-auto apparition">
        <h2 class="section-title">Vous avez un projet ?</h2>
        <p class="text-encre-2 text-lg mb-8">Le premier échange est gratuit et sans engagement.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="btn-primary">Me contacter</a>
          <a href="/projets" class="btn-secondary">Voir les projets</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
