---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ContactForm from '../components/ContactForm.tsx'
import MentionPrix from '../components/MentionPrix.astro'
import Icone from '../components/Icone.astro'

const title = 'Automatisations | Guy Boireau, développeur indépendant à Bordeaux'
const description =
  "Des automatisations pour les tâches que vous refaites à la main : réponses aux demandes, devis, relances, rapports. De 100 € à 500 € et plus par automatisation."

// Cas types : des exemples de ce qu'on peut automatiser, pas des projets
// livrés. Aucun gain chiffré tant qu'il n'a pas été mesuré chez un client.
const casTypes = [
  {
    label: 'Artisan',
    title: 'La demande de devis traitée le dimanche soir',
    scenario:
      "Un client remplit le formulaire de votre site un dimanche soir. Il reçoit tout de suite un e-mail avec vos disponibilités. Lundi matin, sa demande est déjà rangée dans votre outil, avec un rappel dans votre agenda.",
    steps: [
      'Le formulaire est envoyé, la demande est analysée',
      'Un e-mail de confirmation part au client',
      'La demande est rangée dans votre outil (Google Sheets, Notion…)',
      'Un rappel est ajouté à votre agenda',
    ],
  },
  {
    label: 'Restaurant',
    title: 'Une réponse à chaque avis Google',
    scenario:
      "Chaque nouvel avis Google déclenche la rédaction d'une réponse adaptée à son contenu, positif ou négatif. Vous la relisez avant publication, ou elle part seule si vous le souhaitez.",
    steps: [
      'Un nouvel avis Google est détecté',
      'Une réponse adaptée est rédigée',
      'Elle est publiée, après votre relecture ou directement',
      'Un récapitulatif des avis vous arrive chaque semaine',
    ],
  },
  {
    label: 'Indépendant',
    title: 'Du brief reçu par e-mail à la facture',
    scenario:
      "Un brief client arrive par e-mail. Les informations utiles en sont extraites et un brouillon de devis est préparé. La facture part quand le devis est accepté, et les relances suivent à date fixe.",
    steps: [
      'Le brief est reçu et ses informations extraites',
      'Un brouillon de devis est préparé',
      'La facture part quand le devis est accepté',
      'Relances de paiement à 15 et 30 jours',
    ],
  },
]

// Automatisations réellement en service, sur mes propres systèmes.
const enService = [
  {
    title: 'Surveillance de sites',
    desc: "Sept sites contrôlés toutes les 30 minutes : la page répond, le certificat est valide, le nom de domaine n'arrive pas à échéance. Une alerte part sur mon téléphone seulement quand l'état change.",
    stack: 'Node.js, sans dépendance externe',
  },
  {
    title: "Contrôle de l'infrastructure",
    desc: "Un contrôle planifié passe sur l'infrastructure et m'envoie son compte rendu par e-mail. Je vois venir un disque qui se remplit ou un service arrêté.",
    stack: 'Tâche planifiée, rapport par e-mail',
  },
  {
    title: 'Rapports de référencement',
    desc: "Chaque début de mois, les données Search Console de chaque site sont récupérées et mises en forme : requêtes qui amènent des visiteurs, positions gagnées ou perdues.",
    stack: 'API Search Console, génération automatique',
  },
  {
    title: 'Tri du courrier',
    desc: 'Chaque matin, les e-mails reçus sont lus, classés et résumés.',
    stack: 'Agent quotidien',
  },
]

const paliers = [
  {
    nom: 'Simple',
    prix: '100 €',
    resume: 'Un déclencheur, une action.',
    items: [
      'Exemple : formulaire envoyé, e-mail de confirmation',
      'Exemple : paiement reçu, ligne ajoutée dans Google Sheets',
      'Livraison sous 48 h',
      'Support 15 jours inclus',
    ],
    principal: false,
  },
  {
    nom: 'Standard',
    prix: '250 €',
    resume: 'Plusieurs étapes, avec des conditions.',
    items: [
      'Exemple : demande triée, rangée dans votre outil, rendez-vous proposé',
      'Exemple : réponse adaptée à chaque avis Google',
      'Conditions, filtres, délais',
      'Livraison sous 3 jours ouvrés',
      'Support 30 jours inclus',
    ],
    principal: true,
  },
  {
    nom: 'Avec intelligence artificielle',
    prix: 'à partir de 500 €',
    resume: 'Lecture de textes, rédaction, plusieurs outils reliés.',
    items: [
      'Exemple : brief reçu par e-mail, devis préparé',
      'Exemple : réponses à partir de vos propres documents',
      'Modèles de langage (Claude, GPT ou équivalent)',
      'Livraison sous 5 à 7 jours ouvrés',
      'Support 60 jours et documentation',
    ],
    principal: false,
  },
]
---

<BaseLayout {title} {description}>
  <Header />
  <main id="contenu" tabindex="-1" class="focus:outline-none">
    <!-- Intro -->
    <section class="bg-creme border-b border-ligne pt-28 pb-16 md:pt-36 md:pb-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <p class="etiquette mb-6">Automatisations</p>
        <h1 class="text-4xl md:text-6xl leading-[1.08] mb-6">Les tâches que vous refaites chaque semaine, confiées à un programme</h1>
        <p class="text-lg md:text-xl text-encre-2 leading-relaxed max-w-3xl mb-10">
          Répondre aux demandes, préparer les devis, relancer, compiler des rapports.
          Une automatisation fait une seule de ces choses, et elle la fait à chaque fois.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#demande" class="btn-primary">Décrire ma tâche</a>
          <a href="#cas-types" class="btn-secondary">Voir des cas types</a>
        </div>
      </div>
    </section>

    <!-- Principe -->
    <section class="section">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12">
          <h2 class="section-title">Le principe</h2>
          <p class="text-lg text-encre-2">Un événement déclenche un traitement, qui produit une action.</p>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 apparition">
          {[
            { titre: 'Un événement', texte: 'Un formulaire envoyé, un e-mail reçu, un avis publié, un paiement.' },
            { titre: 'Un traitement', texte: "Le contenu est lu, trié ou rédigé. Avec de l'intelligence artificielle si c'est utile." },
            { titre: 'Une action', texte: 'Un e-mail part, une ligne s’ajoute, un rendez-vous se crée, une facture est prête.' },
          ].map((etape, index) => (
            <li class="carte p-6">
              <p class="font-mono text-[13px] font-medium text-primary-700 mb-4">{index + 1}</p>
              <h3 class="text-xl mb-2">{etape.titre}</h3>
              <p class="text-encre-2">{etape.texte}</p>
            </li>
          ))}
        </ol>

        <p class="font-mono text-[13px] text-encre-3 mt-8 apparition">
          Outils possibles : Make · Google Sheets et Docs · Notion · Airtable · Slack · Gmail · modèles de langage
        </p>
      </div>
    </section>

    <!-- Cas types -->
    <section id="cas-types" class="section bg-creme border-y border-ligne scroll-mt-20">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <h2 class="section-title">Trois cas types</h2>
          <p class="text-lg text-encre-2">Des exemples de ce qu'on peut automatiser. Chaque projet part de votre situation réelle.</p>
        </div>

        <div class="space-y-6">
          {casTypes.map((cas) => (
            <article class="carte p-6 md:p-8 apparition">
              <div class="flex flex-col md:flex-row gap-8">
                <div class="flex-1">
                  <p class="etiquette mb-3">Cas type · {cas.label}</p>
                  <h3 class="text-2xl mb-3">{cas.title}</h3>
                  <p class="text-encre-2 leading-relaxed">{cas.scenario}</p>
                </div>
                <ol class="md:w-72 shrink-0 space-y-3">
                  {cas.steps.map((step, j) => (
                    <li class="flex items-start gap-3 text-encre-2 text-[15px]">
                      <span class="font-mono text-[13px] font-medium text-primary-700 shrink-0 mt-0.5">{j + 1}</span>
                      {step}
                    </li>
                  ))}
                </ol>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- En service -->
    <section class="section">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">En service</p>
          <h2 class="section-title">Ce qui tourne déjà chez moi</h2>
          <p class="text-lg text-encre-2">Avant de proposer ce format à des clients, je l'utilise pour mes propres systèmes.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {enService.map((item) => (
            <div class="bloc-technique p-6 apparition">
              <h3 class="font-mono text-base font-medium text-creme mb-3">{item.title}</h3>
              <p class="font-sans text-[15px] text-creme-sourd leading-relaxed mb-4">{item.desc}</p>
              <p class="text-[13px] text-creme-sourd">{item.stack}</p>
            </div>
          ))}
        </div>

        <p class="text-encre-2 mt-8 apparition max-w-2xl">
          Chacune fait une seule chose. C'est le format que je propose aussi aux clients : petit, testé, documenté.
        </p>
      </div>
    </section>

    <!-- Tarifs -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <h2 class="section-title">Tarifs</h2>
          <p class="text-lg text-encre-2">Le prix dépend du nombre d'étapes et des outils à relier.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {paliers.map((palier) => (
            <div class={`carte p-6 md:p-8 flex flex-col apparition ${palier.principal ? 'border-2 border-primary-500' : ''}`}>
              <h3 class="text-2xl mb-2">{palier.nom}</h3>
              <p class="chiffre text-3xl mb-1">{palier.prix}</p>
              <p class="font-mono text-[13px] text-encre-3 mb-4">par automatisation</p>
              <p class="text-encre-2 mb-6">{palier.resume}</p>
              <ul class="space-y-3 flex-grow mb-8">
                {palier.items.map((item) => (
                  <li class="flex items-start gap-3 text-encre-2 text-[15px]">
                    <Icone nom="check" class="text-primary-500 mt-0.5 shrink-0" />{item}
                  </li>
                ))}
              </ul>
              <a href="#demande" class={palier.principal ? 'btn-primary' : 'btn-secondary'}>
                En parler<span class="sr-only"> : palier {palier.nom}</span>
              </a>
            </div>
          ))}
        </div>

        <p class="text-encre-2 mt-8 apparition">Vous hésitez entre deux paliers ? Décrivez votre besoin, je vous oriente.</p>
        <MentionPrix class="mt-3" />
      </div>
    </section>

    <!-- Demande -->
    <section id="demande" class="section scroll-mt-20">
      <div class="max-w-2xl mx-auto">
        <div class="apparition mb-10">
          <h2 class="section-title">Décrivez la tâche</h2>
          <p class="text-lg text-encre-2">
            Pas besoin de vocabulaire technique. Dites-moi ce que vous faites à la main et que vous ne voulez plus faire.
            Je réponds sous 24 h.
          </p>
        </div>
        <div class="carte p-6 md:p-8">
          <ContactForm client:visible defaultType="automatisation" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
