---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ContactForm from '../components/ContactForm.tsx'

const title = 'Automatisations IA — Guy Boireau | Workflows Make + IA sur-mesure'
const description =
  'Supprimez vos tâches répétitives avec des automatisations IA sur-mesure. Formulaire → réponse en 60s, leads qualifiés, factures automatiques. Dès 500€/automatisation.'

const useCases = [
  {
    icon: '🔨',
    label: 'Artisan',
    title: 'Le devis qui part tout seul',
    scenario:
      'Un client remplit le formulaire de votre site le dimanche soir. En 60 secondes, il reçoit un email de confirmation avec vos disponibilités et une estimation tarifaire. Lundi matin, vous trouvez le lead qualifié dans votre agenda.',
    steps: [
      'Formulaire soumis → IA analyse la demande',
      'Email de confirmation envoyé automatiquement',
      'Lead créé dans votre outil (Notion, Google Sheets…)',
      'Rappel planifié dans votre agenda',
    ],
    gain: '2h économisées par semaine',
  },
  {
    icon: '🍽️',
    label: 'Restaurant',
    title: 'Les avis Google traités en automatique',
    scenario:
      'Chaque nouvel avis Google déclenche une réponse personnalisée générée par IA en moins de 5 minutes — adaptée au contenu de l\'avis, positive ou négative. Votre réputation progresse sans effort.',
    steps: [
      'Nouvel avis Google détecté',
      'IA rédige une réponse contextualisée',
      'Réponse postée automatiquement',
      'Rapport hebdomadaire des avis reçus',
    ],
    gain: '100% des avis répondus',
  },
  {
    icon: '💼',
    label: 'Agence / Freelance',
    title: 'Le back-office qui tourne tout seul',
    scenario:
      'Un brief client arrive par email → l\'IA l\'analyse, extrait les infos clés et génère un brouillon de devis. La facture part dès validation. Les relances de paiement sont planifiées. Vous vous concentrez sur le travail.',
    steps: [
      'Email de brief reçu → extraction automatique',
      'Brouillon de devis généré en 30 secondes',
      'Facture envoyée à validation du devis',
      'Relances automatiques J+15, J+30',
    ],
    gain: '5h de back-office supprimées',
  },
]
---

<BaseLayout {title} {description}>
  <Header />
  <main>
    <!-- Hero -->
    <section class="section bg-slate-50 pt-32">
      <div class="max-w-4xl mx-auto text-center">
        <div class="reveal-fade-up">
          <span class="inline-block px-4 py-1.5 bg-primary-500/10 text-primary-600 rounded-full text-sm font-semibold mb-6">
            Automatisations IA
          </span>
          <h1 class="section-title">
            Votre formulaire répond tout seul<br />
            <span class="text-gradient">pendant que vous dormez</span>
          </h1>
          <p class="section-subtitle">
            Pas de code à maintenir. Pas de tâche manuelle. Juste votre business qui tourne.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
            <a href="#demo" class="btn-primary inline-block">Demander une démo</a>
            <a href="#cas-usage" class="btn-secondary inline-block">Voir des exemples concrets</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Flow visuel -->
    <section class="section bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="reveal-fade-up mb-12 text-center">
          <h2 class="section-title">Comment ça marche ?</h2>
          <p class="section-subtitle">Un trigger → une action → un résultat</p>
        </div>

        <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-0 reveal-fade-up">
          <!-- Étape 1 -->
          <div class="glass-card p-6 text-center w-full md:w-48 shrink-0">
            <div class="text-3xl mb-3">📥</div>
            <p class="font-bold text-slate-800 text-sm">Déclencheur</p>
            <p class="text-slate-500 text-xs mt-1">Formulaire, email, avis, paiement…</p>
          </div>

          <!-- Flèche -->
          <div class="hidden md:flex items-center px-2 text-primary-400 text-2xl font-bold">→</div>
          <div class="md:hidden text-primary-400 text-2xl font-bold">↓</div>

          <!-- Étape 2 -->
          <div class="glass-card p-6 text-center w-full md:w-48 shrink-0 border border-primary-500/30">
            <div class="text-3xl mb-3">🤖</div>
            <p class="font-bold text-slate-800 text-sm">IA + Make</p>
            <p class="text-slate-500 text-xs mt-1">Analyse, génère, décide</p>
          </div>

          <!-- Flèche -->
          <div class="hidden md:flex items-center px-2 text-primary-400 text-2xl font-bold">→</div>
          <div class="md:hidden text-primary-400 text-2xl font-bold">↓</div>

          <!-- Étape 3 -->
          <div class="glass-card p-6 text-center w-full md:w-48 shrink-0">
            <div class="text-3xl mb-3">📤</div>
            <p class="font-bold text-slate-800 text-sm">Action</p>
            <p class="text-slate-500 text-xs mt-1">Email, CRM, agenda, facture…</p>
          </div>

          <!-- Flèche -->
          <div class="hidden md:flex items-center px-2 text-primary-400 text-2xl font-bold">→</div>
          <div class="md:hidden text-primary-400 text-2xl font-bold">↓</div>

          <!-- Résultat -->
          <div class="glass-card p-6 text-center w-full md:w-48 shrink-0 bg-primary-500/5">
            <div class="text-3xl mb-3">✅</div>
            <p class="font-bold text-slate-800 text-sm">Résultat</p>
            <p class="text-slate-500 text-xs mt-1">En moins de 60 secondes</p>
          </div>
        </div>

        <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4 reveal-fade-up">
          {['Make (ex-Integromat)', 'Claude / GPT-4o', 'Google Sheets & Docs', 'Notion, Airtable, Slack'].map((tool) => (
            <div class="text-center">
              <span class="inline-block px-3 py-1.5 bg-slate-100 text-slate-600 rounded-full text-xs font-medium border border-slate-200">
                {tool}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Cas d'usage -->
    <section id="cas-usage" class="section bg-slate-50">
      <div class="max-w-6xl mx-auto">
        <div class="reveal-fade-up mb-12 text-center">
          <h2 class="section-title">3 exemples concrets</h2>
          <p class="section-subtitle">Des automatisations déjà opérationnelles</p>
        </div>

        <div class="space-y-8">
          {useCases.map((uc, i) => (
            <div class={`glass-card p-8 stagger-item hover:border-primary-500/30 transition-all duration-300 ${i === 1 ? 'border-2 border-primary-500/30' : ''}`}>
              <div class="flex flex-col md:flex-row gap-8">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-4">
                    <span class="text-3xl">{uc.icon}</span>
                    <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-full text-xs font-medium border border-slate-200">{uc.label}</span>
                  </div>
                  <h3 class="text-xl font-bold text-slate-800 mb-3">{uc.title}</h3>
                  <p class="text-slate-500 leading-relaxed mb-6">{uc.scenario}</p>
                  <div class="inline-flex items-center gap-2 px-4 py-2 bg-green-500/10 text-green-700 rounded-full text-sm font-semibold border border-green-500/20">
                    <span>⏱</span> {uc.gain}
                  </div>
                </div>
                <div class="md:w-64 shrink-0">
                  <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Le flow</p>
                  <ul class="space-y-3">
                    {uc.steps.map((step, j) => (
                      <li class="flex items-start gap-3">
                        <span class="shrink-0 w-5 h-5 rounded-full bg-primary-500/20 text-primary-600 text-xs font-bold flex items-center justify-center mt-0.5">
                          {j + 1}
                        </span>
                        <span class="text-slate-600 text-sm">{step}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="section bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="reveal-fade-up text-center mb-12">
          <h2 class="section-title">Tarifs clairs</h2>
          <p class="section-subtitle">Plus c'est complexe, plus c'est puissant</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <!-- Basique -->
          <div class="glass-card p-8 flex flex-col stagger-item">
            <div class="mb-6">
              <h3 class="text-xl font-bold text-slate-800 mb-2">Basique</h3>
              <div class="flex items-end gap-1 mb-3">
                <span class="text-4xl font-bold text-gradient">100€</span>
                <span class="text-slate-500 mb-1">/ automatisation</span>
              </div>
              <p class="text-slate-500 text-sm">Un déclencheur, une action. Idéal pour démarrer.</p>
            </div>
            <ul class="space-y-3 flex-grow mb-8">
              {[
                'Ex : formulaire → email de confirmation',
                'Ex : nouvel avis → notification Slack',
                'Ex : paiement reçu → ligne dans Google Sheets',
                'Livraison sous 48h',
                'Support 15 jours inclus',
              ].map((item) => (
                <li class="flex items-start gap-2 text-slate-600 text-sm">
                  <span class="text-primary-400 mt-0.5 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
            <a href="#demo" class="btn-secondary text-center block">Démarrer</a>
          </div>

          <!-- Standard -->
          <div class="glass-card p-8 border-2 border-primary-500/70 flex flex-col stagger-item relative shadow-lg shadow-primary-500/10">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-primary-500 rounded-full text-white text-xs font-semibold whitespace-nowrap">
              Le plus demandé
            </div>
            <div class="mb-6">
              <h3 class="text-xl font-bold text-slate-800 mb-2">Standard</h3>
              <div class="flex items-end gap-1 mb-3">
                <span class="text-4xl font-bold text-gradient">250€</span>
                <span class="text-slate-500 mb-1">/ automatisation</span>
              </div>
              <p class="text-slate-500 text-sm">Workflow multi-étapes avec logique conditionnelle.</p>
            </div>
            <ul class="space-y-3 flex-grow mb-8">
              {[
                'Ex : lead → qualification → CRM → agenda',
                'Ex : formulaire → réponse IA en 60 s',
                'Ex : avis Google → réponse automatique contextualisée',
                'Logique si/sinon, filtres, délais',
                'Livraison sous 3 jours ouvrés',
                'Support 30 jours inclus',
              ].map((item) => (
                <li class="flex items-start gap-2 text-slate-600 text-sm">
                  <span class="text-primary-400 mt-0.5 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
            <a href="#demo" class="btn-primary text-center block">Choisir ce palier</a>
          </div>

          <!-- Sur-mesure -->
          <div class="glass-card p-8 flex flex-col stagger-item">
            <div class="mb-6">
              <h3 class="text-xl font-bold text-slate-800 mb-2">Sur-mesure</h3>
              <div class="flex items-end gap-1 mb-3">
                <span class="text-4xl font-bold text-gradient">500€+</span>
                <span class="text-slate-500 mb-1">/ automatisation</span>
              </div>
              <p class="text-slate-500 text-sm">IA avancée, RAG, plusieurs systèmes connectés.</p>
            </div>
            <ul class="space-y-3 flex-grow mb-8">
              {[
                'Ex : brief email → devis généré par IA',
                'Ex : agent de back-office autonome',
                'Ex : RAG sur votre base de connaissances',
                'Intégration Claude / GPT-4o',
                'Livraison sous 5–7 jours ouvrés',
                'Support 60 jours + documentation',
              ].map((item) => (
                <li class="flex items-start gap-2 text-slate-600 text-sm">
                  <span class="text-primary-400 mt-0.5 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
            <a href="#demo" class="btn-secondary text-center block">Discuter du projet</a>
          </div>
        </div>

        <p class="text-center text-slate-500 text-sm mt-6 reveal-fade-up">
          Pas sûr du palier ? Décrivez votre besoin — je vous oriente sans engagement.
        </p>
      </div>
    </section>

    <!-- Démo / Formulaire -->
    <section id="demo" class="section bg-slate-50">
      <div class="max-w-2xl mx-auto">
        <div class="reveal-fade-up text-center mb-10">
          <h2 class="section-title">Décrivez votre besoin</h2>
          <p class="section-subtitle">Je vous réponds sous 24h avec une proposition concrète</p>
          <p class="text-slate-500">
            Pas besoin d'être technique. Décrivez juste la tâche que vous faites à la main et que vous aimeriez ne plus faire.
          </p>
        </div>
        <ContactForm client:load defaultType="automatisation" />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
