---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MentionPrix from '../components/MentionPrix.astro'
import Icone from '../components/Icone.astro'

const title = 'Traitement automatique de documents | Guy Boireau, développeur à Bordeaux'
const description =
  "Bons de livraison, certificats matière, fiches techniques, factures : lus, contrôlés et classés sans ressaisie. Automatisation du traitement documentaire pour les PME, en complément de votre outil de gestion."
const keywords =
  "automatisation traitement documentaire, extraction données documents entreprise, OCR intelligent PME, automatisation saisie bordeaux, lecture automatique de documents, reconnaissance documents industriels"

const problemes = [
  {
    title: 'La ressaisie',
    desc: "Un document arrive, quelqu'un le lit, recopie ses données dans un logiciel, puis le range. Ce trajet est refait à chaque document, tous les jours, par des personnes qui ont mieux à faire.",
  },
  {
    title: 'Les erreurs de recopie',
    desc: "Un chiffre inversé sur une quantité, une référence mal lue sur un certificat matière. L'erreur se découvre trois semaines plus tard, à la livraison ou à la facturation.",
  },
  {
    title: 'Les documents introuvables',
    desc: "Le document existe, quelque part : boîte mail, dossier réseau, classeur. Le retrouver prend dix minutes. Le montrer à un client ou à un auditeur en prend trente.",
  },
  {
    title: 'Le volume qui ne suit pas',
    desc: "Le traitement manuel tient tant que les volumes restent stables. Il casse dès que l'activité augmente, et embaucher pour de la saisie n'est pas une réponse durable.",
  },
]

const etapes = [
  {
    num: '01',
    title: 'Lecture automatique',
    desc: "Le document est lu tel qu'il arrive : scan, photo prise au téléphone dans l'atelier, PDF d'un fournisseur, pièce jointe d'un email. Les données utiles en sont extraites : références, quantités, dates, numéros de lot, montants.",
  },
  {
    num: '02',
    title: 'Contrôle de cohérence',
    desc: "Les données lues sont confrontées à ce que vous savez déjà : la commande correspondante existe-t-elle, les quantités concordent-elles, la référence fournisseur est-elle connue, la date est-elle plausible. Une donnée lue correctement mais incohérente est aussi un problème.",
  },
  {
    num: '03',
    title: 'Seuil de confiance',
    desc: "Chaque extraction porte un score. Au-dessus du seuil, le document est traité automatiquement, sans intervention. En dessous, il part dans une file de vérification humaine, avec le champ douteux mis en évidence. Personne ne relit ce qui est certain.",
    highlight: true,
  },
  {
    num: '04',
    title: 'Classement et intégration',
    desc: "Le document est archivé au bon endroit, indexé sur ses données, et les informations extraites partent dans votre système existant : ERP, outil de gestion, base interne, ou tableur si c'est ce que vous utilisez.",
  },
]

const faq = [
  {
    q: "En quoi est-ce différent d'un OCR classique ?",
    a: "Un OCR transforme une image en texte. Il ne sait pas qu'un nombre est une quantité, que cette quantité doit correspondre à une commande, ni qu'un document mal cadré gagnerait à être relu par un humain. Le travail utile est là : comprendre la structure, contrôler la cohérence, et savoir reconnaître ses propres limites.",
  },
  {
    q: 'Et si la lecture se trompe ?',
    a: "C'est l'hypothèse de départ, pas l'exception. L'architecture est construite pour que les cas incertains soient identifiés comme tels et repris par un humain avant d'entrer dans vos données. Le taux d'automatisation se règle : plus le seuil est haut, moins il y a d'erreurs et plus il y a de reprises manuelles. On l'ajuste sur vos documents réels.",
  },
  {
    q: 'Faut-il changer notre logiciel de gestion ?',
    a: "Non. Le traitement documentaire vient en amont et alimente ce que vous utilisez déjà. Remplacer un ERP en service est un projet d'un autre ordre. Et c'est rarement une bonne idée quand le vrai problème est la saisie.",
  },
  {
    q: 'Combien de documents faut-il pour que ça vaille le coup ?',
    a: "L'ordre de grandeur à partir duquel le calcul est favorable se situe autour de quelques dizaines de documents par semaine, dès lors que chacun demande plusieurs minutes de traitement. En dessous, un projet plus simple suffit souvent, et je vous le dirai.",
  },
  {
    q: 'Nos documents sont très spécifiques à notre métier.',
    a: "C'est le cas courant, et c'est plutôt favorable : un document métier a une structure stable et un vocabulaire fermé, ce qui rend le contrôle de cohérence plus fiable que sur un document générique. Le diagnostic préalable sert à mesurer cette variabilité sur vos propres pièces.",
  },
]
---

<BaseLayout {title} {description} {keywords}>
  <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })} />
  <Header />
  <main id="contenu" tabindex="-1" class="focus:outline-none">
    <!-- Intro -->
    <section class="bg-creme border-b border-ligne pt-28 pb-16 md:pt-36 md:pb-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <p class="etiquette mb-6">Traitement de documents</p>
        <h1 class="text-4xl md:text-6xl leading-[1.08] mb-6">Vos documents lus, contrôlés et classés, sans ressaisie</h1>
        <p class="text-lg md:text-xl text-encre-2 leading-relaxed max-w-3xl">
          Bons de livraison, certificats matière, fiches techniques, factures. Dans beaucoup d'ateliers, l'information arrive sur papier ou en PDF,
          puis quelqu'un la recopie dans un logiciel. C'est ce passage qui peut être outillé.
        </p>
      </div>
    </section>

    <!-- Le problème -->
    <section class="section">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Le problème</p>
          <h2 class="section-title">Ce que coûte la saisie à la main</h2>
          <p class="text-lg text-encre-2">Rarement spectaculaire, toujours quotidien.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {problemes.map((item) => (
            <div class="carte p-6 apparition">
              <h3 class="text-xl mb-3">{item.title}</h3>
              <p class="text-encre-2 text-[15px] leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Comment ça marche -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Comment ça marche</p>
          <h2 class="section-title">Quatre étapes, dont une qui fait tout</h2>
          <p class="text-lg text-encre-2">La troisième, le seuil de confiance, rend le reste utilisable.</p>
        </div>

        <ol class="space-y-6">
          {etapes.map((etape) => (
            <li class={`carte p-6 md:p-8 apparition flex flex-col md:flex-row gap-6 ${etape.highlight ? 'border-2 border-primary-500' : ''}`}>
              <span class="font-mono text-[13px] font-medium text-primary-700 shrink-0 md:w-12 mt-1.5">{etape.num}</span>
              <div class="flex-1">
                <h3 class="text-2xl mb-3">{etape.title}</h3>
                <p class="text-encre-2 leading-relaxed">{etape.desc}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="bloc-technique p-6 md:p-8 mt-8 apparition">
          <p class="text-creme font-medium mb-2">Pourquoi le seuil de confiance compte</p>
          <p class="font-sans text-creme-sourd leading-relaxed">
            Un système qui traite 100 % des documents seul introduit des erreurs sans que personne ne les voie.
            Un système qui demande une validation pour chaque document ne fait rien gagner.
            L'intérêt est entre les deux : automatiser ce qui est certain, faire vérifier ce qui ne l'est pas, et rendre visible la frontière.
          </p>
        </div>
      </div>
    </section>

    <!-- Preuve -->
    <section class="section">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">En bêta privée</p>
          <h2 class="section-title">Le cas Niido</h2>
          <p class="text-lg text-encre-2">La vérification des justificatifs dans une application mobile.</p>
        </div>

        <div class="carte p-6 md:p-10 apparition">
          <p class="text-encre-2 leading-relaxed mb-8">
            Niido met en relation des prestataires du bâtiment et des gestionnaires de biens. Chaque prestataire qui s'inscrit fournit des pièces :
            identité, assurance, justificatifs professionnels. Les vérifier une par une ne tient plus au-delà de quelques dizaines d'inscriptions.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="carte-creme p-6">
              <p class="etiquette mb-2">Premier essai</p>
              <h3 class="text-xl mb-2">Une reconnaissance de texte classique</h3>
              <p class="text-encre-2 text-[15px] leading-relaxed">
                Elle fonctionnait sur des documents propres, scannés à plat. Sur de vraies photos prises au téléphone, de travers, avec un reflet,
                elle échouait trop souvent. Elle a été abandonnée.
              </p>
            </div>
            <div class="carte-creme p-6 border-primary-500">
              <p class="etiquette mb-2">Solution retenue</p>
              <h3 class="text-xl mb-2">Une architecture hybride</h3>
              <p class="text-encre-2 text-[15px] leading-relaxed">
                Lecture par un modèle de vision, contrôle de cohérence des champs, score de confiance par document,
                et une file de vérification humaine pour les seuls cas douteux. Le modérateur ne voit plus que ce qui pose question.
              </p>
            </div>
          </div>

          <p class="font-mono text-[13px] text-encre-3 mb-6">React Native · Expo · Supabase · TypeScript · API Anthropic</p>

          <p class="text-encre-2 leading-relaxed">
            La leçon compte plus que la technique. Sur des documents produits par des gens pressés, la qualité d'entrée est le vrai problème.
            Une architecture qui suppose des documents propres échoue. Une architecture qui mesure son incertitude tient.
          </p>

          <a href="/projets" class="lien text-sm inline-block mt-6">La fiche du projet Niido</a>
        </div>
      </div>
    </section>

    <!-- Positionnement ERP -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-4xl mx-auto apparition">
        <p class="etiquette mb-4">Avec votre ERP</p>
        <h2 class="section-title mb-8">En complément de votre ERP, jamais à sa place</h2>
        <div class="space-y-6 text-encre-2 text-lg leading-relaxed">
          <p>
            Si vous avez un ERP, il reste. Il gère vos stocks, vos achats et votre comptabilité, mieux que ce que je pourrais construire.
          </p>
          <p>
            Les ERP industriels ont souvent deux angles morts. <strong class="text-encre font-medium">La saisie sur le terrain</strong> :
            une photo dans l'atelier, une fiche remplie sur téléphone, sans connexion. Et <strong class="text-encre font-medium">la lecture des documents entrants</strong>
            pour en tirer des données. Ces deux manques se comblent autour de l'ERP, pas contre lui.
          </p>
          <p class="text-base">
            Concrètement, les données extraites entrent dans votre ERP par ce qu'il propose déjà : import de fichier ou API.
            Si votre éditeur facture chaque connexion, il faut le savoir tôt. Le diagnostic le vérifie.
          </p>
        </div>
      </div>
    </section>

    <!-- Tarifs -->
    <section class="section">
      <div class="max-w-4xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Budget</p>
          <h2 class="section-title">Au forfait, annoncé avant de commencer</h2>
        </div>

        <div class="carte p-6 md:p-10 apparition">
          <p class="chiffre text-4xl md:text-5xl mb-3">de 9 000 à 22 000 €</p>
          <p class="text-encre-2 mb-8">Selon le périmètre : types de documents, volume, systèmes à raccorder.</p>

          <dl class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            {[
              { t: 'Ce qui fait monter le prix', d: "Plusieurs familles de documents très différentes, un ERP fermé ou sans API, beaucoup de règles de contrôle." },
              { t: 'Ce qui le fait baisser', d: "Une seule famille de documents, une structure stable, un logiciel d'arrivée avec une API propre." },
              { t: "Ce qui n'est pas compris", d: "L'abonnement au service de lecture, facturé à l'usage par le fournisseur. Comptez quelques dizaines d'euros par mois pour des volumes courants." },
            ].map((item) => (
              <div class="carte-creme p-5">
                <dt class="font-medium text-encre mb-2">{item.t}</dt>
                <dd class="text-encre-2 text-[15px] leading-relaxed">{item.d}</dd>
              </div>
            ))}
          </dl>

          <p class="text-encre-2 mb-8">
            Ces chiffres n'ont pas de sens sans avoir vu vos documents. Le diagnostic préalable mesure la variété réelle de vos pièces
            et le taux d'automatisation atteignable, avant que vous ne vous engagiez.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact?subject=Traitement%20documentaire" class="btn-primary">Demander un diagnostic</a>
            <a href="/services" class="btn-secondary">Le détail du diagnostic</a>
          </div>
          <MentionPrix class="mt-6" />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-3xl mx-auto">
        <div class="apparition mb-8">
          <h2 class="section-title">Questions fréquentes</h2>
        </div>

        <div class="divide-y divide-ligne border-y border-ligne">
          {faq.map((item) => (
            <details class="group py-4 apparition">
              <summary class="text-encre font-medium text-lg list-none flex items-center justify-between gap-4 cursor-pointer">
                {item.q}
                <Icone nom="chevron-down" class="text-primary-500 shrink-0 transition-transform group-open:rotate-180" />
              </summary>
              <p class="text-encre-2 mt-4 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
