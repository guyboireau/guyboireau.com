---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Footer from '../components/Footer.astro'
import ChatBot from '../components/ChatBot.tsx'

const title = 'Guy Boireau — Votre présence sur Internet, clé en main | Développeur Web Freelance Bordeaux'
const description =
  'Guy Boireau, développeur web freelance à Bordeaux. Création de site web à partir de 500€ avec simulateur de devis interactif. Maintenance mensuelle dès 79€/mois, sans engagement. Devis gratuit.'

const services = [
  {
    icon: '🌐',
    title: 'Sites vitrines & CMS',
    description:
      'Un site rapide, bien référencé sur Google et facile à mettre à jour. Parfait pour présenter votre activité et attirer des clients.',
    link: '/services',
  },
  {
    icon: '📱',
    title: 'Applications web & mobile',
    description:
      'Applications métier sur-mesure, interfaces d\'administration, API REST, apps iOS/Android avec React Native.',
    link: '/services',
  },
  {
    icon: '🔧',
    title: 'Suivi & maintenance',
    description:
      'Votre site mis à jour, sauvegardé et optimisé chaque mois. Formules à partir de 149€/mois, sans engagement.',
    link: '/services',
  },
  {
    icon: '🤖',
    title: 'Automatisations IA',
    description:
      'Vos tâches répétitives, on les supprime. Formulaire → réponse client en 60 s, leads qualifiés automatiquement, factures et relances en automatique.',
    link: '/automatisations',
  },
]

const featuredProjects = [
  {
    title: 'La Lucarne Péniche',
    subtitle: 'Site web culturel avec CMS et panneau d\'administration',
    techs: ['React 19', 'Supabase', 'Vercel', 'JavaScript'],
    link: 'https://www.lalucarnepeniche.com',
    status: 'En production',
    images: { desktop: '/assets/lalucarne-desktop.png', mobile: '/assets/lalucarne-mobile.png' },
  },
  {
    title: 'Niido',
    subtitle: 'Marketplace mobile de services à domicile (iOS / Android)',
    techs: ['React Native', 'Expo', 'Supabase', 'TypeScript'],
    link: null,
    status: 'En phase de debug',
    images: { desktop: '/assets/niido-admin.png', mobile: '/assets/niido-mobile.png' },
  },
  {
    title: 'Les Cours de Clara',
    subtitle: 'Plateforme de réservation de cours FLE avec paiement Stripe',
    techs: ['React', 'NestJS', 'PostgreSQL', 'Stripe'],
    link: 'https://claraaltounian.com/',
    status: 'En production',
    images: null,
  },
]
---

<BaseLayout {title} {description}>
  <Header />
  <main>
    <Hero />

    <!-- Services overview -->
    <section class="section bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="reveal-fade-up">
          <h2 class="section-title text-center">Ce que je fais</h2>
          <p class="section-subtitle text-center">De la création au suivi, je m'occupe de tout</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {services.map((service) => (
            <a href={service.link} class="glass-card p-8 hover:border-primary-500/40 transition-all duration-300 group stagger-item block">
              <div class="text-4xl mb-4">{service.icon}</div>
              <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-primary-400 transition-colors">
                {service.title}
              </h3>
              <p class="text-slate-500 text-sm leading-relaxed">{service.description}</p>
              <span class="inline-block mt-4 text-primary-400 text-sm font-medium">
                En savoir plus →
              </span>
            </a>
          ))}
        </div>

        <div class="text-center mt-10 reveal-fade-up">
          <a href="/services" class="btn-primary inline-block">
            Voir toutes mes offres & tarifs
          </a>
        </div>
      </div>
    </section>

    <!-- Chatbot -->
    <section class="section bg-slate-50">
      <div class="max-w-2xl mx-auto">
        <div class="reveal-fade-up">
          <h2 class="section-title text-center">Une question ?</h2>
          <p class="section-subtitle text-center">Mon assistant répond en direct</p>
        </div>
        <ChatBot client:load />
      </div>
    </section>

    <!-- Featured projects -->
    <section class="section bg-slate-50">
      <div class="max-w-6xl mx-auto">
        <div class="reveal-fade-up">
          <h2 class="section-title text-center">Projets récents</h2>
          <p class="section-subtitle text-center">Ce que j'ai livré pour mes clients</p>
        </div>

        <div class="space-y-8">
          {featuredProjects.map((project) => (
            <div class="glass-card p-8 hover:border-primary-500/30 transition-all duration-300 stagger-item">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
                <div>
                  <h3 class="text-2xl font-bold text-primary-400 mb-1">{project.title}</h3>
                  <p class="text-slate-600">{project.subtitle}</p>
                </div>
                <span class="px-3 py-1 bg-green-500/20 text-green-700 rounded-full text-sm border border-green-500/30 shrink-0 self-start">
                  {project.status}
                </span>
              </div>

              {project.images && (
                <div class="flex flex-col md:flex-row gap-4 mb-6">
                  <img
                    src={project.images.desktop}
                    alt={`${project.title} desktop`}
                    class="w-full md:w-2/3 rounded-lg border border-slate-200 shadow-lg object-cover"
                    loading="lazy"
                  />
                  <img
                    src={project.images.mobile}
                    alt={`${project.title} mobile`}
                    class="w-full md:w-1/3 rounded-lg border border-slate-200 shadow-lg object-cover"
                    loading="lazy"
                  />
                </div>
              )}

              <div class="flex flex-wrap gap-2 mb-4">
                {project.techs.map((tech) => (
                  <span class="px-2 py-1 bg-slate-100 text-slate-600 rounded text-xs border border-slate-200">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex gap-4">
                <a href="/projets" class="text-primary-400 hover:text-primary-600 transition-colors text-sm font-medium">
                  Voir les détails →
                </a>
                {project.link && (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-primary-400 transition-colors text-sm">
                    Visiter le site ↗
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <div class="text-center mt-10 reveal-fade-up">
          <a href="/projets" class="btn-secondary inline-block">
            Voir tous mes projets
          </a>
        </div>
      </div>
    </section>

    <!-- Artisans & commerces locaux -->
    <section class="section bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="reveal-fade-up mb-12 text-center">
          <span class="inline-block px-4 py-1.5 bg-primary-500/10 text-primary-600 rounded-full text-sm font-semibold mb-4">
            Artisans & commerces locaux
          </span>
          <h2 class="section-title">Votre site doit travailler pour vous</h2>
          <p class="section-subtitle">Pas pour votre prestataire web</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
          {[
            {
              icon: '📍',
              title: 'Visible sur Google Maps',
              desc: 'Votre fiche Google Business mise à jour chaque mois : horaires, photos, actualités. Les gens vous trouvent quand ils cherchent un artisan près de chez eux.',
            },
            {
              icon: '📞',
              title: 'Un site qui donne envie d\'appeler',
              desc: 'Rapide, mobile, avec vos réalisations en photos. Un visiteur doit comprendre ce que vous faites et vous contacter en moins de 30 secondes.',
            },
            {
              icon: '🛠️',
              title: 'Je m\'occupe de tout',
              desc: 'Hébergement, mises à jour, pannes, modifications de contenu. Vous faites votre métier, je fais le mien. Aucune compétence technique requise.',
            },
          ].map((item) => (
            <div class="glass-card p-8 stagger-item text-center">
              <div class="text-4xl mb-4">{item.icon}</div>
              <h3 class="text-lg font-bold text-slate-800 mb-3">{item.title}</h3>
              <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="glass-card p-8 border-2 border-primary-500/30 reveal-scale">
          <div class="flex flex-col md:flex-row md:items-center gap-6">
            <div class="flex-1">
              <div class="inline-block px-3 py-1 bg-primary-500 rounded-full text-white text-xs font-semibold mb-3">
                Simulateur interactif
              </div>
              <h3 class="text-2xl font-bold text-slate-800 mb-2">
                Votre site à partir de <span class="text-gradient">500€</span> — composez-le en direct
              </h3>
              <p class="text-slate-500">
                Cochez les options dont vous avez besoin (pages supplémentaires, formulaire, boutique, blog…) et voyez le prix se calculer en temps réel. Transparent, sans surprise.
              </p>
            </div>
            <a href="/services" class="btn-primary shrink-0 inline-block text-center">
              Simuler mon devis →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Témoignages -->
    <section class="section bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="reveal-fade-up mb-12 text-center">
          <h2 class="section-title">Ce qu'ils en disent</h2>
          <p class="section-subtitle">Des clients, pas des témoignages de catalogue</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="glass-card p-8 stagger-item border border-primary-500/20">
            <div class="text-primary-400 text-4xl mb-4 leading-none">"</div>
            <p class="text-slate-600 leading-relaxed mb-6">
              Guy a construit notre site de A à Z et s'occupe de tout depuis. On n'a rien à faire — il gère les mises à jour, notre fiche Google, les photos. C'est exactement ce qu'on cherchait.
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-primary-500/20 flex items-center justify-center text-primary-500 font-bold shrink-0">
                GB
              </div>
              <div>
                <p class="font-semibold text-slate-800 text-sm">Gilles Boireau</p>
                <p class="text-slate-500 text-xs">La Lucarne Péniche — Saint-Léger-des-Vignes</p>
              </div>
            </div>
          </div>

          <div class="glass-card p-8 stagger-item border border-primary-500/20">
            <div class="text-primary-400 text-4xl mb-4 leading-none">"</div>
            <p class="text-slate-600 leading-relaxed mb-6">
              Guy a créé un site à l'image de mon atelier — élégant, multilingue, avec une galerie que je gère seul. Depuis la mise en ligne, je reçois des demandes de clients anglophones et espagnols que je n'aurais jamais touchés avant.
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-primary-500/20 flex items-center justify-center text-primary-500 font-bold shrink-0">
                AJ
              </div>
              <div>
                <p class="font-semibold text-slate-800 text-sm">Arnault Janvier</p>
                <p class="text-slate-500 text-xs">Maître Verrier — arnault-janvier.fr</p>
              </div>
            </div>
          </div>

          <div class="glass-card p-8 stagger-item border border-primary-500/20">
            <div class="text-primary-400 text-4xl mb-4 leading-none">"</div>
            <p class="text-slate-600 leading-relaxed mb-6">
              Avant, je passais du temps à gérer mon agenda par email. Maintenant mes étudiants réservent et paient en ligne directement. Le site s'est rentabilisé en quelques semaines.
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-primary-500/20 flex items-center justify-center text-primary-500 font-bold shrink-0">
                CA
              </div>
              <div>
                <p class="font-semibold text-slate-800 text-sm">Clara Altounian</p>
                <p class="text-slate-500 text-xs">Cours de français FLE — claraaltounian.com</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Availability banner -->
    <section class="section bg-slate-50">
      <div class="max-w-4xl mx-auto text-center">
        <div class="glass-card p-10 border-2 border-green-500/30 reveal-scale">
          <div class="inline-flex items-center gap-3 mb-6">
            <span class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></span>
            <span class="text-green-600 text-xl font-semibold">Disponible pour de nouveaux projets</span>
          </div>
          <p class="text-slate-600 text-lg mb-8">
            Vous avez un projet en tête ? Je réponds sous 24h.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="btn-primary inline-block">
              Demander un devis gratuit
            </a>
            <a href="/services" class="btn-secondary inline-block">
              Voir les formules
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Dépannage informatique -->
    <section class="section bg-slate-50">
      <div class="max-w-4xl mx-auto">
        <div class="glass-card p-8 md:p-12 reveal-fade-up">
          <div class="flex flex-col md:flex-row gap-8 items-center">
            <div class="text-6xl shrink-0">🖥️</div>
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-3">
                Besoin d'aide avec votre ordinateur ?
              </h2>
              <p class="text-slate-600 mb-4 text-lg">
                Je propose aussi du <strong class="text-primary-400">dépannage informatique à distance</strong> pour les professionnels et particuliers.
                Diagnostic et résolution rapide de vos problèmes.
              </p>
              <div class="flex flex-wrap gap-4 mb-6">
                <div class="bg-slate-50 rounded-xl px-5 py-3 border border-slate-200">
                  <p class="text-2xl font-bold text-primary-400">35€<span class="text-base font-normal text-slate-500">/h</span></p>
                  <p class="text-slate-500 text-sm">Tarif horaire</p>
                </div>
                <div class="bg-slate-50 rounded-xl px-5 py-3 border border-slate-200">
                  <p class="text-slate-800 font-medium">100% à distance</p>
                  <p class="text-slate-500 text-sm">Prise en main à distance</p>
                </div>
                <div class="bg-slate-50 rounded-xl px-5 py-3 border border-slate-200">
                  <p class="text-slate-800 font-medium">Réponse rapide</p>
                  <p class="text-slate-500 text-sm">Sous 24h</p>
                </div>
              </div>
              <a href="/contact" class="btn-primary inline-block">
                Demander un dépannage
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
