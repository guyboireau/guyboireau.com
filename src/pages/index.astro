---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Footer from '../components/Footer.astro'
import ChatBot from '../components/ChatBot.tsx'
import MentionPrix from '../components/MentionPrix.astro'
import Icone from '../components/Icone.astro'
import { AVIS } from '../data/avis'
import AvisClients from '../components/AvisClients.astro'
import ListeAvis from '../components/ListeAvis.astro'
import { Image } from 'astro:assets'
import lalucarneDesktop from '../assets/lalucarne-desktop.png'
import lalucarneMobile from '../assets/lalucarne-mobile.png'
import niidoAdmin from '../assets/niido-admin.png'
import niidoMobile from '../assets/niido-mobile.png'
import arnaultDesktop from '../assets/arnault-desktop.webp'

const title = 'Guy Boireau, développeur indépendant à Bordeaux : applications métier et sites'
const description =
  'Je développe des applications métier, des automatisations et des sites pour les PME et les artisans, puis je les héberge en France. Réponse sous 24 h.'

const services = [
  {
    icone: 'app-window',
    title: 'Applications métier et automatisation',
    description:
      "Suivi de commandes, fiches de contrôle, planning d'interventions. L'outil qui manque entre votre ERP et vos tableurs, et les tâches répétitives en moins.",
    link: '/services',
  },
  {
    icone: 'file-text',
    title: 'Traitement de documents',
    description:
      'Bons de livraison, certificats matière, factures. Lus, contrôlés et classés sans ressaisie.',
    link: '/traitement-documentaire',
  },
  {
    icone: 'globe',
    title: 'Sites pour artisans et commerces',
    description:
      'Un site rapide, trouvé sur Google, que vous mettez à jour vous-même. Avec un suivi mensuel.',
    link: '/services#sites',
  },
  {
    icone: 'server',
    title: 'Hébergement et suivi',
    description:
      "Votre application hébergée en France, surveillée et sauvegardée par la personne qui l'a écrite.",
    link: '/hebergement-exploitation',
  },
] as const

const situations = [
  "Votre site a plusieurs années, ou vous n'en avez pas.",
  'Vos clients ne vous trouvent pas sur Google.',
  'Vos équipes refont chaque semaine les mêmes saisies : devis, relances, rendez-vous.',
  "Votre ancien prestataire ne répond plus, et personne ne s'occupe du site.",
]

const etapes = [
  {
    titre: 'On en parle',
    texte: 'Un appel ou un message, gratuit et sans engagement. Je comprends votre activité et votre budget.',
  },
  {
    titre: 'Je chiffre',
    texte: 'Vous recevez un devis détaillé, à prix fixe, avec un délai annoncé.',
  },
  {
    titre: 'Je construis',
    texte: 'Je livre par étapes. Vous testez et validez chacune avant la suivante.',
  },
  {
    titre: 'Je mets en ligne',
    texte: "Je vous forme à l'outil. Les anomalies sont corrigées pendant la garantie prévue aux CGV.",
  },
]

const realisations = [
  {
    title: 'La Lucarne Péniche',
    subtitle: 'Une programmation culturelle publiée par l’équipe elle-même',
    description:
      "Chaque nouvel événement passait par un prestataire. L'équipe publie maintenant ses événements, ses actualités et ses photos seule, en quelques minutes.",
    techs: ['React 19', 'Supabase', 'VPS OVHcloud'],
    link: 'https://www.lalucarnepeniche.com',
    status: 'En production',
    images: { desktop: lalucarneDesktop, mobile: lalucarneMobile },
  },
  {
    title: 'Arnault Janvier, maître verrier',
    subtitle: 'Un site en trois langues avec une galerie gérée par l’artisan',
    description:
      "Un atelier d'art peu visible hors de sa région. Depuis le site en français, anglais et espagnol, il reçoit des demandes de clients anglophones et hispanophones.",
    techs: ['Next.js 16', 'TypeScript', 'Supabase'],
    link: 'https://www.arnault-janvier-vitrail.fr',
    status: 'En production',
    images: { desktop: arnaultDesktop },
  },
  {
    title: 'Niido',
    subtitle: 'Une application mobile qui vérifie les justificatifs des prestataires',
    description:
      "Les pièces d'identité et justificatifs sont lus et contrôlés automatiquement. Une personne ne reprend que les cas douteux. Quatre rôles d'utilisateurs et un espace d'administration.",
    techs: ['React Native', 'Expo', 'Supabase', 'TypeScript'],
    link: null,
    status: 'En bêta privée, pas encore sur les stores',
    images: { desktop: niidoAdmin, mobile: niidoMobile },
  },
]

const offreSite = [
  {
    icone: 'map-pin',
    titre: 'Trouvé sur Google Maps',
    texte: 'Je mets à jour votre fiche Google chaque mois : horaires, photos, actualités.',
  },
  {
    icone: 'phone',
    titre: 'Un site qui fait appeler',
    texte: 'Rapide, lisible sur téléphone, avec vos réalisations en photos et votre numéro bien visible.',
  },
  {
    icone: 'wrench',
    titre: 'Je gère la technique',
    texte: 'Hébergement, mises à jour, pannes et changements de contenu. Vous gardez votre temps pour votre métier.',
  },
] as const
---

<BaseLayout {title} {description}>
  <Header />
  <main id="contenu" tabindex="-1" class="focus:outline-none">
    <Hero />

    <!-- Services -->
    <section class="section">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Services</p>
          <h2 class="section-title">Ce que je fais</h2>
          <p class="text-lg text-encre-2">Je conçois, je développe, je mets en ligne. Puis je reste responsable de ce qui tourne.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {services.map((service) => (
            <a href={service.link} class="carte carte-lien p-6 group apparition block">
              <Icone nom={service.icone} taille={24} class="text-primary-500 mb-6" />
              <h3 class="text-xl mb-3 group-hover:text-primary-700 transition-colors">{service.title}</h3>
              <p class="text-encre-2 text-[15px] leading-relaxed">{service.description}</p>
            </a>
          ))}
        </div>

        <div class="mt-12 apparition">
          <a href="/services" class="btn-secondary">Voir les services et les tarifs</a>
        </div>
      </div>
    </section>

    <!-- Situations -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-4xl mx-auto">
        <div class="apparition mb-8">
          <h2 class="section-title">Quatre situations que je sais régler</h2>
        </div>

        <ul class="divide-y divide-ligne border-y border-ligne mb-12">
          {situations.map((texte) => (
            <li class="flex items-start gap-4 py-4 apparition">
              <Icone nom="check" class="text-primary-500 shrink-0 mt-1" />
              <p class="text-encre text-lg">{texte}</p>
            </li>
          ))}
        </ul>

        <div class="apparition">
          <a href="/contact" class="btn-primary">Me décrire votre situation</a>
        </div>
      </div>
    </section>

    <!-- Réalisations -->
    <section class="section">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Réalisations</p>
          <h2 class="section-title">Trois projets, trois clients</h2>
          <p class="text-lg text-encre-2">Des projets en ligne ou en test, présentés avec l'accord des clients.</p>
        </div>

        <div class="space-y-8">
          {realisations.map((project) => (
            <article class="carte p-6 md:p-8 apparition">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
                <div>
                  <h3 class="text-2xl mb-1">{project.title}</h3>
                  <p class="text-encre-2">{project.subtitle}</p>
                </div>
                <span class="font-mono text-[13px] text-encre-2 border border-ligne rounded px-2 py-1 shrink-0 self-start">
                  {project.status}
                </span>
              </div>

              <p class="text-encre-2 leading-relaxed mb-6 max-w-3xl">{project.description}</p>

              <div class="flex flex-col md:flex-row gap-4 mb-6">
                <Image
                  src={project.images.desktop}
                  alt={`Capture d'écran du site ${project.title} sur ordinateur`}
                  widths={project.images.mobile ? [480, 960] : [480, 960, 1440]}
                  sizes={project.images.mobile ? '(max-width: 768px) 100vw, 640px' : '(max-width: 768px) 100vw, 960px'}
                  format="webp"
                  class={`w-full ${project.images.mobile ? 'md:w-2/3' : ''} rounded border border-ligne object-cover`}
                  loading="lazy"
                />
                {project.images.mobile && (
                  <Image
                    src={project.images.mobile}
                    alt={`Capture d'écran de ${project.title} sur téléphone`}
                    widths={[320, 640]}
                    sizes="(max-width: 768px) 100vw, 320px"
                    format="webp"
                    class="w-full md:w-1/3 rounded border border-ligne object-cover"
                    loading="lazy"
                  />
                )}
              </div>

              <p class="font-mono text-[13px] text-encre-3 mb-4">{project.techs.join(' · ')}</p>

              <div class="flex flex-wrap gap-x-6 gap-y-2">
                <a href="/projets" class="lien text-sm">
                  Le détail du projet<span class="sr-only"> {project.title}</span>
                </a>
                {project.link && (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="lien text-sm">
                    Voir le site<span class="sr-only"> de {project.title} (nouvel onglet)</span>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Déroulé -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Déroulé</p>
          <h2 class="section-title">Du premier message à la mise en ligne</h2>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {etapes.map((etape, index) => (
            <li class="carte p-6 apparition">
              <p class="font-mono text-[13px] font-medium text-primary-700 mb-4">Étape {index + 1}</p>
              <h3 class="text-xl mb-3">{etape.titre}</h3>
              <p class="text-encre-2 text-[15px] leading-relaxed">{etape.texte}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Avis : ceux publiés dans le CRM, lus à la demande (îlot serveur).
         Repli rendu au build : les avis vérifiés de data/avis.ts. -->
    <AvisClients server:defer>
      <ListeAvis slot="fallback" avis={AVIS} />
    </AvisClients>

    <!-- Offre artisans et commerces -->
    <section class="section" id="artisans">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Artisans et commerces</p>
          <h2 class="section-title">Un site à l'abonnement, sans rien gérer</h2>
          <p class="text-lg text-encre-2">
            Pour les activités qui ont besoin d'être trouvées, pas d'une application. C'est une offre à part, plus simple.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          {offreSite.map((item) => (
            <div class="carte p-6 apparition">
              <Icone nom={item.icone} taille={24} class="text-primary-500 mb-6" />
              <h3 class="text-xl mb-3">{item.titre}</h3>
              <p class="text-encre-2 text-[15px] leading-relaxed">{item.texte}</p>
            </div>
          ))}
        </div>

        <div class="carte-creme p-6 md:p-8 apparition flex flex-col md:flex-row md:items-center gap-6">
          <div class="flex-1">
            <p class="font-mono text-2xl font-medium text-primary-700 mb-2">490 € de mise en service, puis un abonnement mensuel</p>
            <p class="text-encre-2">
              Sur la page des tarifs, cochez les options dont vous avez besoin et le total se calcule. Engagement de 12 mois, premier mois offert.
            </p>
          </div>
          <a href="/services#simulateur" class="btn-primary shrink-0">Calculer mon tarif</a>
        </div>
      </div>
    </section>

    <!-- Dépannage informatique -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-4xl mx-auto apparition">
        <div class="flex flex-col md:flex-row gap-8">
          <Icone nom="monitor" taille={32} class="text-primary-500 shrink-0" />
          <div>
            <h2 class="text-2xl md:text-3xl mb-4">Dépannage informatique à distance</h2>
            <p class="text-encre-2 text-lg mb-6">
              Pour les professionnels et les particuliers. Je prends la main sur votre ordinateur, avec votre accord, et je règle le problème.
            </p>
            <ul class="flex flex-wrap gap-x-8 gap-y-2 font-mono text-[13px] text-encre-2 mb-6">
              <li><span class="text-primary-700 font-medium">35 € de l'heure</span></li>
              <li>Entièrement à distance</li>
              <li>Réponse sous 24 h</li>
            </ul>
            <a href="/contact" class="btn-secondary">Demander un dépannage</a>
            <MentionPrix class="mt-4" />
          </div>
        </div>
      </div>
    </section>

    <!-- Assistant automatique -->
    <section class="section">
      <div class="max-w-2xl mx-auto">
        <div class="apparition mb-8">
          <p class="etiquette mb-4">Assistant automatique</p>
          <h2 class="section-title">Une question rapide ?</h2>
          <p class="text-encre-2">
            Un programme d'intelligence artificielle répond ici à partir des informations de ce site. Ce n'est pas moi qui écris.
            Pour un vrai échange, utilisez la page contact.
          </p>
        </div>
        <ChatBot client:visible />
      </div>
    </section>

    <!-- Contact -->
    <section class="section bg-foret">
      <div class="max-w-4xl mx-auto apparition">
        <h2 class="text-3xl md:text-4xl text-creme mb-4">Parlons de votre projet</h2>
        <p class="text-creme-sourd text-lg mb-8">Écrivez-moi ou appelez-moi. Je réponds sous 24 h.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="btn-primary">Me contacter</a>
          <a href="tel:+33675751439" class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-creme-sourd text-creme font-medium rounded hover:bg-creme/10 transition-colors">
            <Icone nom="phone" />06 75 75 14 39
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
