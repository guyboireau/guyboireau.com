---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ContactForm from '../components/ContactForm'
import Icone from '../components/Icone.astro'

const title = 'Contact | Guy Boireau, développeur indépendant à Bordeaux'
const description =
  'Écrivez ou appelez Guy Boireau pour une application, un site ou un dépannage. Réponse sous 24 h, premier échange gratuit.'
---

<BaseLayout {title} {description}>
  <Header />
  <main id="contenu" tabindex="-1" class="focus:outline-none">
    <section class="bg-creme border-b border-ligne pt-28 pb-16 md:pt-36 md:pb-24 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <div class="mb-12 max-w-2xl">
          <p class="etiquette mb-6">Contact</p>
          <h1 class="text-4xl md:text-6xl leading-[1.08] mb-6">Parlons de votre projet</h1>
          <p class="text-lg md:text-xl text-encre-2">Le premier échange est gratuit. Je réponds sous 24 h.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-8">
          <div class="carte p-6 md:p-8">
            <h2 class="sr-only">Formulaire de contact</h2>
            <ContactForm client:load />
          </div>

          <div>
            <h2 class="sr-only">Coordonnées</h2>
            <dl class="divide-y divide-ligne border-y border-ligne">
              <div class="flex gap-4 py-5">
                <Icone nom="mail" class="text-primary-500 shrink-0 mt-1" />
                <div>
                  <dt class="etiquette mb-1">E-mail</dt>
                  <dd><a href="mailto:me@guyboireau.com" class="lien">me@guyboireau.com</a></dd>
                </div>
              </div>
              <div class="flex gap-4 py-5">
                <Icone nom="phone" class="text-primary-500 shrink-0 mt-1" />
                <div>
                  <dt class="etiquette mb-1">Téléphone</dt>
                  <dd>
                    <a href="tel:+33675751439" class="lien">06 75 75 14 39</a>
                    <p class="text-encre-2 text-sm mt-1">Vous préférez parler ? Appelez, ou laissez un message pour fixer un créneau.</p>
                  </dd>
                </div>
              </div>
              <div class="flex gap-4 py-5">
                <Icone nom="map-pin" class="text-primary-500 shrink-0 mt-1" />
                <div>
                  <dt class="etiquette mb-1">Où</dt>
                  <dd class="text-encre-2">Bordeaux, et à distance partout en France</dd>
                </div>
              </div>
              <div class="flex gap-4 py-5">
                <Icone nom="user" class="text-primary-500 shrink-0 mt-1" />
                <div>
                  <dt class="etiquette mb-1">LinkedIn</dt>
                  <dd>
                    <a href="https://www.linkedin.com/in/guy-boireau" target="_blank" rel="noopener noreferrer" class="lien break-all">
                      linkedin.com/in/guy-boireau<span class="sr-only"> (nouvel onglet)</span>
                    </a>
                  </dd>
                </div>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
