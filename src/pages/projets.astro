---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Icone from '../components/Icone.astro'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import lalucarneDesktop from '../assets/lalucarne-desktop.png'
import lalucarneMobile from '../assets/lalucarne-mobile.png'
import niidoAdmin from '../assets/niido-admin.png'
import niidoMobile from '../assets/niido-mobile.png'
import arnaultDesktop from '../assets/arnault-desktop.webp'

const title = 'Projets | Guy Boireau, développeur indépendant à Bordeaux'
const description =
  "Les projets de Guy Boireau : le site multilingue d'Arnault Janvier, maître verrier, celui de La Lucarne Péniche et l'application Niido."

interface Projet {
  title: string
  subtitle: string
  description: string
  points: string[]
  stack: Record<string, string[]>
  images: { desktop: ImageMetadata; mobile?: ImageMetadata; legendeDesktop?: string; legendeMobile?: string }
  link: string | null
  infos: string[]
}

const projetsClients: Projet[] = [
  {
    title: 'Arnault Janvier, maître verrier',
    subtitle: 'Un site en trois langues avec une galerie gérée par l’artisan',
    description:
      "Arnault Janvier est vitrailliste (Glassncraft Studio), à Paris avec un second atelier à Moulins. Son atelier était peu visible hors de sa région. Le site est en français, en anglais et en espagnol, et il reçoit depuis des demandes de clients anglophones et hispanophones.",
    points: [
      'Arnault gère seul sa galerie et ses projets, depuis son espace de gestion',
      'Trois langues : français, anglais, espagnol',
      'Galerie par thème : création, restauration, art contemporain',
      'Formulaire de contact avec pièces jointes, protégé contre les robots par Cloudflare Turnstile',
      'Référencement : données structurées, hreflang, plan du site par langue',
      'Hébergé en France depuis septembre 2026, sur un serveur privé virtuel (VPS) OVHcloud, avec sa base Supabase auto-hébergée',
    ],
    stack: {
      Interface: ['Next.js 16', 'React 19', 'TypeScript', 'Tailwind CSS 4'],
      Données: ['Supabase', 'PostgreSQL', 'Supabase Storage'],
      Langues: ['next-intl'],
      Formulaires: ['React Hook Form', 'Zod', 'Resend'],
      Hébergement: ['VPS OVHcloud (France)', 'Supabase auto-hébergé'],
    },
    images: { desktop: arnaultDesktop },
    link: 'https://www.arnault-janvier-vitrail.fr',
    infos: ['Mission indépendante', 'Janvier 2026', 'En production'],
  },
  {
    title: 'La Lucarne Péniche',
    subtitle: 'Une programmation culturelle publiée par l’équipe elle-même',
    description:
      "La Lucarne est une péniche culturelle à Saint-Léger-des-Vignes. Sa programmation change chaque semaine, et chaque modification passait par un prestataire. L'équipe publie maintenant ses événements, ses actualités et ses photos seule.",
    points: [
      "L'équipe gère seule ses événements, ses articles et ses photos",
      'Aucune compétence technique nécessaire pour mettre à jour le site',
      "Formation de l'équipe à l'espace de gestion",
      'Hébergé en France, sur un VPS OVHcloud, avec sa base Supabase auto-hébergée',
    ],
    stack: {
      Interface: ['React 19', 'React Router 7', 'Vite 7'],
      Données: ['Supabase', 'PostgreSQL', 'Row Level Security'],
      Hébergement: ['VPS OVHcloud (France)', 'Supabase auto-hébergé'],
    },
    images: { desktop: lalucarneDesktop, mobile: lalucarneMobile },
    link: 'https://www.lalucarnepeniche.com',
    infos: ['Mission indépendante', 'Janvier 2026', 'En production'],
  },
  {
    title: 'Niido',
    subtitle: 'Une application mobile qui vérifie les justificatifs des prestataires',
    description:
      "Niido met en relation des prestataires du bâtiment et des services à domicile avec des particuliers et des gestionnaires de logements. Vérifier à la main les pièces de chaque prestataire ne tient pas quand le nombre grandit : l'application les lit et les contrôle, et une personne ne reprend que les cas douteux.",
    points: [
      "Pièces d'identité et justificatifs lus et contrôlés automatiquement, avec un score de confiance",
      'Les prestataires reçoivent leurs missions sur leur téléphone',
      'Messagerie en temps réel entre clients et prestataires',
      "Quatre rôles d'utilisateurs, et un espace d'administration pour l'équipe Niido",
    ],
    stack: {
      Mobile: ['React Native 0.86', 'Expo SDK 57', 'TypeScript', 'React Navigation 7'],
      'Lecture de documents': ['API Anthropic', 'Score de confiance'],
      Données: ['Supabase', 'PostgreSQL', 'RLS', 'Edge Functions'],
      Administration: ['React 19', 'Vite', 'TypeScript', 'Tailwind CSS'],
      Outillage: ['React Query 5', 'Zod', 'GitHub Actions', 'Sentry', 'Vitest'],
    },
    images: {
      desktop: niidoAdmin,
      mobile: niidoMobile,
      legendeDesktop: "Espace d'administration",
      legendeMobile: 'Application mobile',
    },
    link: null,
    infos: ['Mission indépendante', 'Depuis 2025', 'En bêta privée, pas encore sur les stores'],
  },
]

const projetsPersonnels = [
  {
    title: 'SkateDev',
    description: 'Les skate-parks d’Ottawa, avec notes et commentaires.',
    techs: ['TypeScript', 'React'],
    link: 'https://github.com/guyboireau/SkateDev',
  },
  {
    title: 'TriviaTrainer',
    description: 'Une application de quiz.',
    techs: ['Vue.js', 'JavaScript'],
    link: 'https://github.com/guyboireau/TriviaTrainer',
  },
  {
    title: 'BioDesignLab',
    description: 'Une plateforme collaborative de ressources pédagogiques.',
    techs: ['TypeScript', 'GraphQL', 'React'],
    link: 'https://gitlab.com/guyboireau/BioDesignLab',
  },
  {
    title: 'LuxuryCar',
    description: 'Un catalogue de voitures en PHP, architecture MVC.',
    techs: ['PHP', 'MVC', 'MySQL'],
    link: 'https://github.com/guyboireau/LuxuryCar',
  },
  {
    title: 'OccasAuto',
    description: "Une application de gestion de véhicules d'occasion en C#.",
    techs: ['C#', '.NET'],
    link: 'https://github.com/guyboireau/OccasAuto-C-',
  },
]
---

<BaseLayout {title} {description}>
  <Header />
  <main id="contenu" tabindex="-1" class="focus:outline-none">
    <!-- Intro -->
    <section class="bg-creme border-b border-ligne pt-28 pb-16 md:pt-36 md:pb-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <p class="etiquette mb-6">Projets</p>
        <h1 class="text-4xl md:text-6xl leading-[1.08] mb-6">Ce que j'ai construit, et pour qui</h1>
        <p class="text-lg md:text-xl text-encre-2 leading-relaxed max-w-3xl">
          Trois projets clients, présentés avec leur accord. Puis un outil personnel et des projets de formation.
        </p>
      </div>
    </section>

    <!-- Projets clients -->
    <section class="section">
      <div class="max-w-6xl mx-auto space-y-12">
        {projetsClients.map((project) => (
          <article class="carte p-6 md:p-10 apparition">
            <p class="font-mono text-[13px] text-encre-3 mb-4">{project.infos.join(' · ')}</p>
            <h2 class="text-3xl md:text-4xl mb-2">{project.title}</h2>
            <p class="text-encre-2 text-lg mb-6">{project.subtitle}</p>

            <p class="text-encre leading-relaxed mb-8 max-w-3xl">{project.description}</p>

            <div class="flex flex-col md:flex-row gap-4 mb-8">
              <figure class={project.images.mobile ? 'md:w-2/3' : 'w-full'}>
                <Image
                  src={project.images.desktop}
                  alt={`Capture d'écran de ${project.title}${project.images.legendeDesktop ? ` : ${project.images.legendeDesktop.toLowerCase()}` : ' sur ordinateur'}`}
                  widths={project.images.mobile ? [480, 960] : [480, 960, 1440]}
                  sizes={project.images.mobile ? '(max-width: 768px) 100vw, 640px' : '(max-width: 768px) 100vw, 960px'}
                  format="webp"
                  class="w-full rounded border border-ligne object-cover"
                  loading="lazy"
                />
                {project.images.legendeDesktop && (
                  <figcaption class="font-mono text-[13px] text-encre-3 mt-2">{project.images.legendeDesktop}</figcaption>
                )}
              </figure>
              {project.images.mobile && (
                <figure class="md:w-1/3">
                  <Image
                    src={project.images.mobile}
                    alt={`Capture d'écran de ${project.title} sur téléphone`}
                    widths={[320, 640]}
                    sizes="(max-width: 768px) 100vw, 320px"
                    format="webp"
                    class="w-full rounded border border-ligne object-cover"
                    loading="lazy"
                  />
                  {project.images.legendeMobile && (
                    <figcaption class="font-mono text-[13px] text-encre-3 mt-2">{project.images.legendeMobile}</figcaption>
                  )}
                </figure>
              )}
            </div>

            <div class="grid gap-8 md:grid-cols-2 mb-8">
              <div>
                <h3 class="text-xl mb-4">Ce que fait le projet</h3>
                <ul class="space-y-3">
                  {project.points.map((point) => (
                    <li class="flex items-start gap-3 text-encre-2">
                      <Icone nom="check" class="text-primary-500 mt-0.5 shrink-0" />{point}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="text-xl mb-4">Technique</h3>
                <dl class="space-y-3">
                  {Object.entries(project.stack).map(([label, techs]) => (
                    <div>
                      <dt class="etiquette">{label}</dt>
                      <dd class="font-mono text-sm text-encre-2">{techs.join(' · ')}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>

            {project.link && (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                Voir le site<span class="sr-only"> de {project.title} (nouvel onglet)</span>
                <Icone nom="external-link" taille={16} />
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- Outil personnel -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-8">
          <p class="etiquette mb-4">Outil personnel</p>
          <h2 class="section-title">Agent Freelance</h2>
          <p class="text-lg text-encre-2 max-w-3xl">
            Un espace de gestion pour développeur indépendant, construit pour tester l'intégration de modèles de langage dans un vrai outil.
            Le code est public, et une démonstration tourne avec des données fictives.
          </p>
        </div>

        <div class="carte p-6 md:p-8 apparition">
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8">
            {[
              "Analyse d'un brief client et proposition de devis structuré",
              'Discussion avec un agent qui garde la mémoire des échanges',
              'Rédaction de posts LinkedIn et d’e-mails',
              'Documents rangés par client',
              'Suivi des relances',
              'Comparaison des réponses de plusieurs modèles',
            ].map((point) => (
              <li class="flex items-start gap-3 text-encre-2">
                <Icone nom="check" class="text-primary-500 mt-0.5 shrink-0" />{point}
              </li>
            ))}
          </ul>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://github.com/guyboireau/agent-freelance" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              Voir le code<span class="sr-only"> d'Agent Freelance sur GitHub (nouvel onglet)</span>
              <Icone nom="external-link" taille={16} />
            </a>
            <a href="https://agent-freelance.vercel.app" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              Ouvrir la démonstration<span class="sr-only"> (nouvel onglet)</span>
              <Icone nom="external-link" taille={16} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Projets de formation -->
    <section class="section">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-8">
          <p class="etiquette mb-4">Formation</p>
          <h2 class="section-title">Projets d'école et exercices</h2>
        </div>

        <ul class="divide-y divide-ligne border-y border-ligne">
          {projetsPersonnels.map((project) => (
            <li class="grid gap-2 md:grid-cols-[200px_minmax(0,1fr)_auto] md:items-baseline py-4 apparition">
              <h3 class="text-xl">{project.title}</h3>
              <p class="text-encre-2">
                {project.description}
                <span class="block font-mono text-[13px] text-encre-3 mt-1">{project.techs.join(' · ')}</span>
              </p>
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="lien text-sm">
                Code source<span class="sr-only"> de {project.title} (nouvel onglet)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Contact -->
    <section class="section bg-foret">
      <div class="max-w-3xl mx-auto apparition">
        <h2 class="text-3xl md:text-4xl text-creme mb-4">Un projet à me confier ?</h2>
        <p class="text-creme-sourd text-lg mb-8">Le premier échange est gratuit et sans engagement.</p>
        <a href="/contact" class="btn-primary">Me contacter</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
