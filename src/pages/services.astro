---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const title = 'Services & Tarifs | Guy Boireau — Développeur Web Freelance Bordeaux'
const description =
  'Formules de maintenance mensuelle à partir de 149€/mois, création de site web dès 2000€, dépannage informatique 35€/h. Développeur web freelance à Bordeaux.'

const faq = [
  {
    q: 'C\'est quoi exactement la gestion de la fiche Google Business ?',
    a: 'Google Business (anciennement Google My Business) est la fiche qui apparaît sur Google Maps quand on cherche un artisan ou commerce local. Je m\'occupe de la créer si elle n\'existe pas, de mettre à jour vos horaires, ajouter des photos de vos réalisations, publier des actualités et répondre aux avis. Un artisan sans fiche active perd en moyenne 30% de ses demandes locales.',
  },
  {
    q: 'Y a-t-il un engagement de durée ?',
    a: 'Non, les formules mensuelles sont sans engagement. Vous pouvez arrêter ou changer de formule à tout moment.',
  },
  {
    q: "Qu'est-ce qui est inclus dans la maintenance ?",
    a: 'Hébergement, nom de domaine, mises à jour de sécurité, sauvegardes automatiques, et les modifications incluses selon la formule (1h/mois en Essentiel, 2h/mois en Accompagnement).',
  },
  {
    q: 'Comment se déroule la création d\'un site ?',
    a: 'Appel découverte gratuit → devis → design → développement → livraison. Je vous tiens informé à chaque étape et vous avez toujours accès aux livrables.',
  },
  {
    q: 'Puis-je garder mon site existant et prendre juste la maintenance ?',
    a: 'Oui, si votre site est techniquement compatible. On en discute lors de l\'appel découverte.',
  },
  {
    q: 'Comment fonctionne le dépannage informatique ?',
    a: 'Vous me contactez, on fixe un créneau. Je me connecte à votre ordinateur à distance (avec votre accord) et résous le problème. Facturation au temps réel passé.',
  },
]
---

<BaseLayout {title} {description}>
  <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  })} />
  <Header />
  <main>
    <!-- Intro -->
    <section class="section bg-slate-50 pt-32">
      <div class="max-w-4xl mx-auto text-center">
        <div class="reveal-fade-up">
          <h1 class="section-title">Services & Tarifs</h1>
          <p class="section-subtitle">
            Votre site est en ligne… et après ? Je m'en occupe pour vous.
          </p>
          <p class="text-slate-600 text-lg max-w-2xl mx-auto">
            Un site web sans suivi, c'est comme une voiture sans entretien. Je vous propose des formules simples pour que votre site reste rapide, sécurisé et visible sur Google.
          </p>
        </div>
      </div>
    </section>

    <!-- Création de site -->
    <section class="section bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="reveal-fade-up mb-12">
          <h2 class="section-title text-center">Création de site web</h2>
          <p class="section-subtitle text-center">Votre site de A à Z, livré clé en main</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="glass-card p-8 stagger-item">
            <div class="text-3xl mb-4">🌐</div>
            <h3 class="text-xl font-bold text-slate-800 mb-2">Site vitrine</h3>
            <div class="flex items-end gap-1 mb-4">
              <span class="text-3xl font-bold text-gradient">à partir de 1 000€</span>
            </div>
            <p class="text-slate-500 text-sm mb-4">Site de présentation moderne, optimisé SEO, avec panneau d'administration si besoin.</p>
            <ul class="space-y-2">
              {['Design sur-mesure', 'Optimisation SEO on-page', 'Responsive mobile', 'Formation à la mise à jour', 'Livraison sous 3-4 semaines'].map((item) => (
                <li class="flex items-start gap-2 text-slate-600 text-sm">
                  <span class="text-primary-400 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
          </div>

          <div class="glass-card p-8 stagger-item">
            <div class="text-3xl mb-4">⚙️</div>
            <h3 class="text-xl font-bold text-slate-800 mb-2">Application web / mobile</h3>
            <div class="flex items-end gap-1 mb-4">
              <span class="text-3xl font-bold text-gradient">à partir de 3 000€</span>
            </div>
            <p class="text-slate-500 text-sm mb-4">Application métier, marketplace, plateforme SaaS, app iOS/Android avec React Native.</p>
            <ul class="space-y-2">
              {['Architecture sur-mesure', 'API REST ou GraphQL', 'Dashboard d\'administration', 'Tests automatisés', 'Documentation technique'].map((item) => (
                <li class="flex items-start gap-2 text-slate-600 text-sm">
                  <span class="text-primary-400 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="text-center mt-8 reveal-fade-up">
          <p class="text-slate-500 mb-4">Chaque projet est unique — parlons-en pour obtenir un devis précis.</p>
          <a href="/contact" class="btn-primary inline-block">Demander un devis gratuit</a>
        </div>
      </div>
    </section>

    <!-- Maintenance plans -->
    <section class="section bg-slate-50">
      <div class="max-w-6xl mx-auto">
        <div class="reveal-fade-up mb-12">
          <h2 class="section-title text-center">Formules de suivi mensuel</h2>
          <p class="section-subtitle text-center">Sans engagement — changez ou arrêtez quand vous voulez</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <!-- Pack Présence -->
          <div class="glass-card p-8 stagger-item flex flex-col">
            <div class="mb-6">
              <h3 class="text-xl font-bold text-slate-800 mb-2">Pack Présence</h3>
              <div class="flex items-end gap-1 mb-3">
                <span class="text-4xl font-bold text-gradient">79€</span>
                <span class="text-slate-500 mb-1">/mois</span>
              </div>
              <p class="text-slate-500 text-sm">Votre site en ligne et votre fiche Google tenue à jour</p>
            </div>
            <ul class="space-y-3 flex-grow mb-8">
              {[
                'Hébergement & domaine inclus',
                'Mises à jour de sécurité',
                'Sauvegardes automatiques',
                'Fiche Google Business gérée ✦',
                'Horaires, photos, infos à jour',
                'Support email sous 72h',
              ].map((item) => (
                <li class="flex items-start gap-2 text-slate-600 text-sm">
                  <span class="text-primary-400 mt-0.5 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn-secondary text-center block">Choisir</a>
          </div>

          <!-- Pack Essentiel -->
          <div class="glass-card p-8 border-2 border-primary-500/70 stagger-item flex flex-col relative shadow-lg shadow-primary-500/10">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-primary-500 rounded-full text-white text-xs font-semibold whitespace-nowrap">
              Recommandé
            </div>
            <div class="mb-6">
              <h3 class="text-xl font-bold text-slate-800 mb-2">Pack Essentiel</h3>
              <div class="flex items-end gap-1 mb-3">
                <span class="text-4xl font-bold text-gradient">149€</span>
                <span class="text-slate-500 mb-1">/mois</span>
              </div>
              <p class="text-slate-500 text-sm">Tout ce qu'il faut pour être visible et gérer votre contenu</p>
            </div>
            <ul class="space-y-3 flex-grow mb-8">
              {[
                'Tout le Pack Présence +',
                '1 modification de contenu/mois',
                'Support email sous 48h',
                'Rapport mensuel simplifié',
              ].map((item) => (
                <li class="flex items-start gap-2 text-slate-600 text-sm">
                  <span class="text-primary-400 mt-0.5 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn-primary text-center block">Choisir ce pack</a>
          </div>

          <!-- Pack Croissance -->
          <div class="glass-card p-8 stagger-item flex flex-col">
            <div class="mb-6">
              <h3 class="text-xl font-bold text-slate-800 mb-2">Pack Croissance</h3>
              <div class="flex items-end gap-1 mb-3">
                <span class="text-4xl font-bold text-gradient">299€</span>
                <span class="text-slate-500 mb-1">/mois</span>
              </div>
              <p class="text-slate-500 text-sm">Pour développer votre clientèle sur le web activement</p>
            </div>
            <ul class="space-y-3 flex-grow mb-8">
              {[
                'Tout le Pack Essentiel +',
                'Optimisation SEO mensuelle',
                '1 article / actualité par mois',
                '2h d\'évolutions incluses',
                'Rapport Google Analytics + Maps',
                'Support prioritaire sous 24h',
                'Appel mensuel de suivi (30 min)',
              ].map((item) => (
                <li class="flex items-start gap-2 text-slate-600 text-sm">
                  <span class="text-primary-400 mt-0.5 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
            <a href="/contact" class="btn-secondary text-center block">Choisir</a>
          </div>
        </div>

        <!-- Google Business explication -->
        <div class="mt-8 glass-card p-6 border border-primary-500/20 reveal-fade-up">
          <div class="flex flex-col sm:flex-row gap-4 items-start">
            <div class="text-3xl shrink-0">📍</div>
            <div>
              <p class="font-semibold text-slate-800 mb-1">✦ C'est quoi la fiche Google Business ?</p>
              <p class="text-slate-500 text-sm leading-relaxed">
                C'est la fiche qui apparaît sur Google Maps quand quelqu'un cherche <em>"plombier Bordeaux"</em> ou <em>"coiffeur près de moi"</em>.
                Elle affiche vos horaires, vos photos, vos avis clients. Un artisan sans fiche à jour perd des appels chaque semaine.
                Je la configure, la mets à jour chaque mois et réponds aux signalements — vous n'avez rien à faire.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dépannage -->
    <section class="section bg-slate-50">
      <div class="max-w-4xl mx-auto">
        <div class="glass-card p-10 reveal-fade-up">
          <div class="flex flex-col md:flex-row gap-8 items-start">
            <div class="text-5xl shrink-0">🖥️</div>
            <div>
              <h2 class="text-2xl font-bold text-slate-800 mb-2">Dépannage informatique</h2>
              <div class="flex items-end gap-1 mb-4">
                <span class="text-3xl font-bold text-gradient">35€</span>
                <span class="text-slate-500 mb-1">/heure</span>
              </div>
              <p class="text-slate-600 mb-4">
                Dépannage à distance pour professionnels et particuliers. Virus, lenteur, problème de connexion, installation logiciel, récupération de données…
              </p>
              <ul class="space-y-2 mb-6">
                {[
                  'Prise en main à distance sécurisée',
                  'Diagnostic gratuit avant intervention',
                  'Facturation au temps réel',
                  'Disponible en soirée et week-end',
                ].map((item) => (
                  <li class="flex items-start gap-2 text-slate-600 text-sm">
                    <span class="text-primary-400 shrink-0">✓</span>{item}
                  </li>
                ))}
              </ul>
              <a href="/contact" class="btn-primary inline-block">Demander un dépannage</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Automatisations IA -->
    <section class="section bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="reveal-fade-up mb-12 text-center">
          <span class="inline-block px-4 py-1.5 bg-primary-500/10 text-primary-600 rounded-full text-sm font-semibold mb-4">
            Nouveau
          </span>
          <h2 class="section-title">Automatisations IA</h2>
          <p class="section-subtitle">Vos tâches répétitives, on les supprime</p>
          <p class="text-slate-600 text-lg max-w-2xl mx-auto">
            Votre formulaire répond tout seul. Vos leads sont qualifiés avant même que vous décrochiez. Vos relances partent sans que vous y pensiez.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
          {[
            {
              icon: '⚡',
              title: 'Réponse automatique en 60 secondes',
              desc: 'Un client remplit votre formulaire de contact → il reçoit une réponse personnalisée en moins d\'une minute, 24h/24, 7j/7.',
            },
            {
              icon: '🎯',
              title: 'Qualification automatique des leads',
              desc: 'Un lead entre → il est qualifié, catégorisé et envoyé directement dans votre CRM ou votre agenda. Vous ne traitez que les vraies opportunités.',
            },
            {
              icon: '📄',
              title: 'Factures, relances & rapports',
              desc: 'Génération automatique de devis et factures, relances de paiement planifiées, rapports hebdomadaires envoyés sans intervention.',
            },
            {
              icon: '🔗',
              title: 'Vos outils connectés entre eux',
              desc: 'Notion, Google Sheets, Slack, Stripe, Airtable, Gmail… Tout ce que vous utilisez déjà, branché ensemble avec Make + IA.',
            },
          ].map((item) => (
            <div class="glass-card p-8 stagger-item hover:border-primary-500/40 transition-all duration-300">
              <div class="text-3xl mb-4">{item.icon}</div>
              <h3 class="text-lg font-bold text-slate-800 mb-2">{item.title}</h3>
              <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="glass-card p-8 border-2 border-primary-500/30 reveal-scale">
          <div class="flex flex-col md:flex-row md:items-center gap-6">
            <div class="flex-1">
              <div class="inline-block px-3 py-1 bg-primary-500 rounded-full text-white text-xs font-semibold mb-3">
                3 paliers de prix
              </div>
              <h3 class="text-2xl font-bold text-slate-800 mb-2">
                À partir de <span class="text-gradient">100€ / automatisation</span>
              </h3>
              <p class="text-slate-500">
                Basique à 100€, standard à 250€, sur-mesure avec IA à partir de 500€. Workflow livré clé en main, testé et documenté.
              </p>
            </div>
            <a href="/automatisations" class="btn-primary shrink-0 inline-block text-center">
              Voir la démo →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section bg-white">
      <div class="max-w-3xl mx-auto">
        <div class="reveal-fade-up">
          <h2 class="section-title text-center">Questions fréquentes</h2>
          <p class="section-subtitle text-center">Tout ce que vous voulez savoir</p>
        </div>

        <div class="space-y-4">
          {faq.map((item) => (
            <details class="glass-card p-6 group stagger-item cursor-pointer">
              <summary class="text-slate-800 font-medium text-lg list-none flex items-center justify-between">
                {item.q}
                <span class="text-primary-400 ml-4 shrink-0 transition-transform group-open:rotate-180">▾</span>
              </summary>
              <p class="text-slate-500 mt-4 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>

        <div class="text-center mt-12 reveal-fade-up">
          <h3 class="text-xl font-bold text-slate-800 mb-3">Encore des questions ?</h3>
          <p class="text-slate-500 mb-6">Écrivez-moi directement, je réponds sous 24h.</p>
          <a href="/contact" class="btn-primary inline-block">Me contacter</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
