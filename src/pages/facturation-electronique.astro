---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import MentionPrix from '../components/MentionPrix.astro'
import Icone from '../components/Icone.astro'

const title = 'Facturation électronique : se mettre en conformité | Guy Boireau, Bordeaux'
const description =
  "Réception des factures électroniques obligatoire depuis le 1er septembre 2026, émission au 1er septembre 2027 pour les PME, TPE et micro-entreprises. Diagnostic, connecteur vers une plateforme agréée, mise en place complète."
const keywords =
  'facturation électronique 2026, obligation facture électronique PME, plateforme agréée facturation, connecteur facturation électronique, mise en conformité facture électronique bordeaux'

const calendrier = [
  {
    date: '1er septembre 2026',
    qui: 'Toutes les entreprises assujetties à la TVA',
    quoi: 'Obligation de pouvoir recevoir des factures électroniques',
    detail:
      "Sans exception de taille. Dès cette date, un fournisseur peut vous adresser ses factures au format électronique et vous devez être en mesure de les recevoir via une plateforme agréée.",
    enVigueur: true,
  },
  {
    date: '1er septembre 2026',
    qui: 'Grandes entreprises et entreprises de taille intermédiaire',
    quoi: "Obligation d'émettre au format électronique",
    detail:
      "Concrètement : si vous facturez une grande entreprise ou une ETI, votre client sera lui-même en flux électronique et vous demandera de suivre.",
    enVigueur: false,
  },
  {
    date: '1er septembre 2027',
    qui: 'PME, TPE et micro-entreprises',
    quoi: "Obligation d'émettre au format électronique",
    detail:
      "Vos factures devront partir dans un format structuré, transmises par une plateforme agréée. Le PDF envoyé par email ne sera plus une facture valide entre entreprises.",
    enVigueur: false,
  },
]

const implications = [
  {
    title: 'Recevoir',
    desc: "Vos factures fournisseurs arriveront par une plateforme, plus par email. Il faut choisir cette plateforme, la raccorder à votre comptabilité et savoir où les factures atterrissent.",
  },
  {
    title: 'Émettre',
    desc: "Une facture électronique n'est pas un PDF : c'est un fichier structuré, lisible par une machine (Factur-X, UBL, CII). Votre outil de facturation doit savoir le produire.",
  },
  {
    title: 'Transmettre les données',
    desc: "En parallèle des factures entre entreprises, certaines opérations (ventes aux particuliers, opérations internationales, encaissements) donnent lieu à une transmission de données à l'administration.",
  },
  {
    title: "Raccorder l'existant",
    desc: "C'est là que ça coince en pratique : entre votre outil de gestion actuel et la plateforme agréée, il manque presque toujours une pièce.",
  },
]

const etapes = [
  {
    num: '01',
    title: "Faire l'inventaire",
    desc: "Combien de factures émises et reçues par mois, dans quel outil, sous quel format, avec quelle reprise manuelle derrière. C'est ce qui détermine tout le reste.",
  },
  {
    num: '02',
    title: 'Choisir une plateforme',
    desc: "Le marché compte plusieurs dizaines de plateformes agréées. Le bon choix dépend de votre volume, de votre logiciel de gestion et de votre secteur, pas du classement du moment.",
  },
  {
    num: '03',
    title: 'Raccorder votre outil',
    desc: "Si votre logiciel propose un connecteur natif vers la plateforme retenue, tant mieux. Sinon, il faut le construire : c'est le cas le plus fréquent hors des grands éditeurs.",
  },
  {
    num: '04',
    title: "Tester avant l'échéance",
    desc: "Émission, réception, rejets, cas particuliers (avoirs, acomptes, autoliquidation). Un raccordement testé en août 2027 est un raccordement testé trop tard.",
  },
]

const offres = [
  {
    title: 'Diagnostic de conformité',
    price: '900 €',
    duration: 'Livré sous 1 semaine',
    desc: "Où vous en êtes, ce qui manque, et quelle plateforme convient à votre situation.",
    items: [
      'Inventaire de vos flux de facturation entrants et sortants',
      'Compatibilité de votre outil de gestion actuel',
      'Comparatif argumenté de 3 plateformes agréées adaptées à votre cas',
      'Plan de mise en conformité daté, avec budget',
      'Document écrit remis en fin de mission',
    ],
    highlighted: false,
  },
  {
    title: 'Connecteur',
    price: 'de 3 500 à 8 000 €',
    duration: 'Selon le nombre de flux',
    desc: "Le pont entre votre outil de gestion et la plateforme agréée.",
    items: [
      'Développement du connecteur émission et réception',
      'Formats structurés : Factur-X, UBL ou CII selon la plateforme',
      'Reprise des cas particuliers : avoirs, acomptes, autoliquidation',
      'Journal des rejets et des relances',
      'Recette avec vos factures réelles avant mise en production',
    ],
    highlighted: true,
  },
  {
    title: 'Mise en place complète',
    price: 'de 6 000 à 12 000 €',
    duration: 'Selon le périmètre',
    desc: "Du diagnostic à la première clôture, sans intermédiaire supplémentaire.",
    items: [
      'Diagnostic inclus',
      'Sélection et contractualisation de la plateforme',
      'Intégration technique complète',
      'Transfert de compétences à votre équipe administrative',
      'Recette et accompagnement sur le premier mois de production',
    ],
    highlighted: false,
  },
]

const faq = [
  {
    q: 'Suis-je concerné si je suis micro-entrepreneur ?',
    a: "Oui. L'obligation de réception au 1er septembre 2026 concerne toutes les entreprises assujetties à la TVA, sans seuil de taille. L'obligation d'émettre arrive au 1er septembre 2027 pour les micro-entreprises comme pour les PME.",
  },
  {
    q: 'Un PDF envoyé par email, ça ne suffit plus ?',
    a: "Entre entreprises, non. Une facture électronique au sens de la réforme est un fichier structuré que le logiciel du destinataire peut lire sans ressaisie. Un PDF classique n'en est pas une. Le format Factur-X est une exception utile : c'est un PDF lisible par un humain, avec les données structurées embarquées à l'intérieur.",
  },
  {
    q: 'Ma plateforme peut-elle être choisie librement ?',
    a: "Vous choisissez votre plateforme parmi celles agréées par l'administration, et votre fournisseur peut en avoir une autre : les plateformes s'échangent les factures entre elles. Le choix engage surtout votre quotidien : tarif, ergonomie, qualité du raccordement à votre outil de gestion.",
  },
  {
    q: 'Mon logiciel de gestion annonce qu\'il sera compatible. Ai-je encore besoin de quelqu\'un ?',
    a: "Parfois non, et je vous le dirai. Le diagnostic sert précisément à ça. Le connecteur devient nécessaire quand votre outil est ancien, spécifique à votre métier, développé en interne, ou quand la compatibilité annoncée ne couvre pas vos cas réels : avoirs, acomptes, refacturation.",
  },
  {
    q: 'Combien de temps faut-il prévoir ?',
    a: "Un diagnostic tient en une semaine. Un connecteur demande de trois à huit semaines selon le nombre de flux et la disponibilité de votre éditeur. L'échéance d'émission est en septembre 2027 : le moment confortable pour s'en occuper, c'est maintenant. Pas au printemps 2027, quand tout le monde s'y mettra.",
  },
]
---

<BaseLayout {title} {description} {keywords}>
  <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })} />
  <Header />
  <main id="contenu" tabindex="-1" class="focus:outline-none">
    <!-- Intro -->
    <section class="bg-creme border-b border-ligne pt-28 pb-16 md:pt-36 md:pb-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <p class="etiquette mb-6">Facturation électronique</p>
        <h1 class="text-4xl md:text-6xl leading-[1.08] mb-6">Facturation électronique : ce qui change pour vous</h1>
        <p class="text-lg md:text-xl text-encre-2 leading-relaxed max-w-3xl">
          Recevoir des factures électroniques est obligatoire depuis le 1er septembre 2026. Les émettre le sera au 1er septembre 2027 pour les PME, les TPE et les micro-entreprises.
          Il s'agit de raccorder votre facturation à une plateforme agréée et de produire un format structuré.
        </p>
      </div>
    </section>

    <!-- Calendrier -->
    <section class="section">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Calendrier</p>
          <h2 class="section-title">Deux dates, trois obligations</h2>
        </div>

        <ol class="divide-y divide-ligne border-y border-ligne">
          {calendrier.map((etape) => (
            <li class="grid gap-4 md:grid-cols-[220px_minmax(0,1fr)] py-6 apparition">
              <div>
                <p class="font-mono text-base font-medium text-primary-700">{etape.date}</p>
                {etape.enVigueur && <p class="font-mono text-[13px] text-encre-2 mt-1">En vigueur</p>}
                <p class="text-encre-2 text-sm mt-1">{etape.qui}</p>
              </div>
              <div>
                <h3 class="text-xl mb-2">{etape.quoi}</h3>
                <p class="text-encre-2 leading-relaxed">{etape.detail}</p>
              </div>
            </li>
          ))}
        </ol>

        <p class="text-encre-2 text-sm mt-6 apparition">
          Calendrier fixé par la loi de finances. Les dates ont déjà été reportées. Elles peuvent l'être encore, mais miser dessus n'est pas une stratégie.
        </p>
      </div>
    </section>

    <!-- Implications -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Ce que ça implique</p>
          <h2 class="section-title">Quatre sujets, dont un seul vraiment technique</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {implications.map((item) => (
            <div class="carte p-6 apparition">
              <h3 class="text-xl mb-3">{item.title}</h3>
              <p class="text-encre-2 text-[15px] leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Étapes -->
    <section class="section">
      <div class="max-w-5xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Marche à suivre</p>
          <h2 class="section-title">Ce que vous devez faire, dans cet ordre</h2>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {etapes.map((etape) => (
            <li class="carte p-6 apparition">
              <p class="font-mono text-[13px] font-medium text-primary-700 mb-4">{etape.num}</p>
              <h3 class="text-xl mb-3">{etape.title}</h3>
              <p class="text-encre-2 text-[15px] leading-relaxed">{etape.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Offres -->
    <section class="section bg-creme border-y border-ligne">
      <div class="max-w-6xl mx-auto">
        <div class="apparition mb-12 max-w-2xl">
          <p class="etiquette mb-4">Offres</p>
          <h2 class="section-title">Trois niveaux d'intervention</h2>
          <p class="text-lg text-encre-2">Vous n'avez pas forcément besoin du troisième.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {offres.map((offre) => (
            <div class={`carte p-6 md:p-8 apparition flex flex-col ${offre.highlighted ? 'border-2 border-primary-500' : ''}`}>
              <h3 class="text-2xl mb-2">{offre.title}</h3>
              <p class="chiffre text-3xl mb-1">{offre.price}</p>
              <p class="font-mono text-[13px] text-encre-3 mb-4">{offre.duration}</p>
              <p class="text-encre-2 mb-6">{offre.desc}</p>
              <ul class="space-y-3 flex-grow mb-8">
                {offre.items.map((item) => (
                  <li class="flex items-start gap-3 text-encre-2 text-[15px]">
                    <Icone nom="check" class="text-primary-500 mt-0.5 shrink-0" />{item}
                  </li>
                ))}
              </ul>
              <a href="/contact?subject=Facturation%20électronique" class={offre.highlighted ? 'btn-primary' : 'btn-secondary'}>
                En parler<span class="sr-only"> : {offre.title}</span>
              </a>
            </div>
          ))}
        </div>

        <p class="text-encre-2 mt-8 apparition max-w-2xl">
          Prix au forfait, annoncés avant de commencer. Le diagnostic est déduit du projet s'il commence dans les 3 mois.
        </p>
        <MentionPrix class="mt-3" />
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="max-w-3xl mx-auto">
        <div class="apparition mb-8">
          <h2 class="section-title">Questions fréquentes</h2>
        </div>

        <div class="divide-y divide-ligne border-y border-ligne">
          {faq.map((item) => (
            <details class="group py-4 apparition">
              <summary class="text-encre font-medium text-lg list-none flex items-center justify-between gap-4 cursor-pointer">
                {item.q}
                <Icone nom="chevron-down" class="text-primary-500 shrink-0 transition-transform group-open:rotate-180" />
              </summary>
              <p class="text-encre-2 mt-4 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section bg-foret">
      <div class="max-w-4xl mx-auto apparition">
        <h2 class="text-3xl md:text-4xl text-creme mb-4">Commencez par le diagnostic</h2>
        <p class="text-creme-sourd text-lg mb-8 max-w-2xl">
          Une semaine, 900 €, un document écrit : ce que vous devez faire, avec quelle plateforme, pour quel budget.
          Si votre outil actuel suffit, le document le dira aussi.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact?subject=Diagnostic%20facturation%20électronique" class="btn-primary">Demander un diagnostic</a>
          <a href="/services" class="inline-flex items-center justify-center px-6 py-3 border border-creme-sourd text-creme font-medium rounded hover:bg-creme/10 transition-colors">Voir toutes les offres</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
