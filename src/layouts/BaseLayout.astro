---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content="Guy Boireau" />
    <meta name="theme-color" content="#a0493b" />
    <meta name="keywords" content={keywords} />
    <!-- Geo tags for local SEO -->
    <meta name="geo.region" content="FR-33" />
    <meta name="geo.placename" content="Bordeaux" />
    <meta name="geo.position" content="44.8378;-0.5792" />
    <meta name="ICBM" content="44.8378, -0.5792" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Guy Boireau, développeur indépendant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sceau gb et nom de Guy Boireau, développeur indépendant à Bordeaux" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Favicons : sceau gb -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="msapplication-TileColor" content="#a0493b" />

    <!-- Police de marque (préchargement) -->
    <link
      rel="preload"
      href="/fonts/cormorant-garamond.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Slot pour JSON-LD supplémentaire par page -->
    <slot name="jsonld" />
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded focus:bg-papier focus:px-4 focus:py-2 focus:font-medium focus:text-primary-700 focus:outline-2 focus:outline-primary-600"
    >
      Aller au contenu
    </a>
    <slot />

    {/* Umami : voir la note en tête de fichier. */}
    <script is:inline defer src="https://stats.guyboireau.com/stats.js" data-website-id="533f0180-52f1-43b3-971d-8ce5521fceb8"></script>

    <!-- Années d'expérience : le HTML porte la valeur du build, le navigateur la recalcule -->
    <script>
      import { anneesExperience } from '../data/experience'

      const annees = String(anneesExperience())
      document.querySelectorAll('[data-annees-experience]').forEach((el) => {
        if (el.textContent !== annees) el.textContent = annees
      })
    </script>

    <!-- Apparition douce (DESIGN.md, « Mouvement ») : une fois, au premier passage
         dans l'écran. Sans IntersectionObserver ou en mouvement réduit, le
         contenu reste simplement à sa place (règles CSS de .apparition). -->
    <script>
      const marquer = () => {
        const elements = document.querySelectorAll('.apparition:not(.visible)')
        if (!('IntersectionObserver' in window)) {
          elements.forEach((el) => el.classList.add('visible'))
          return
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('visible')
              observer.unobserve(entry.target)
            })
          },
          { threshold: 0.05 }
        )
        elements.forEach((el) => observer.observe(el))
      }

      marquer()
      document.addEventListener('astro:page-load', marquer)
    </script>
  </body>
</html>
