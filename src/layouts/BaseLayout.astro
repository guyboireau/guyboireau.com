---
import '../styles/global.css'

// Google Tag Manager retiré le 2026-09-01. GTM se chargeait au premier octet,
// sans bannière ni Consent Mode : un traceur non exempté déposé avant tout
// consentement (art. 82 LIL). Une mesure sans cookie (Umami) suffit à ce site.
// Ne pas réintroduire GTM sans recueil de consentement.
//
// Umami, auto-hébergé sur le VPS (stats.guyboireau.com), remplace Vercel
// Analytics depuis la sortie de Vercel (2026-09-17). Sans cookie. L'adresse IP
// n'est pas stockée par Umami : elle sert à la géolocalisation et à un
// identifiant de session (hachage site + IP + navigateur + sel renouvelé
// chaque mois). Mesure exemptée de consentement (conditions CNIL), décrite
// dans /confidentialite, opposable par la clé localStorage `umami.disabled`.
// L'identifiant de site est public par nature.
//
// Ces notes étaient des commentaires HTML : ils partaient dans chaque page
// publiée. Ici, en frontmatter, ils ne quittent pas le dépôt.

export interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  ogType?: string
  keywords?: string
  /** Page à ne pas indexer (404) : robots noindex, pas d'URL canonique. */
  noindex?: boolean
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
  keywords = 'application métier bordeaux, automatisation de processus entreprise, traitement documentaire automatisé, développeur indépendant bordeaux, logiciel métier PME, automatisation saisie bordeaux, développeur freelance bordeaux',
} = Astro.props

const ogImageAbsolute = new URL(ogImage, Astro.site).toString()

const sameAs = [
  'https://www.linkedin.com/in/guy-boireau',
  'https://github.com/guyboireau',
  'https://gitlab.com/guyboireau',
]

const address = {
  '@type': 'PostalAddress',
  addressLocality: 'Bordeaux',
  addressRegion: 'Nouvelle-Aquitaine',
  postalCode: '33800',
  addressCountry: 'FR',
}

const areaServed = [
  { '@type': 'City', 'name': 'Bordeaux' },
  { '@type': 'City', 'name': 'Mérignac' },
  { '@type': 'City', 'name': 'Pessac' },
  { '@type': 'City', 'name': 'Talence' },
  { '@type': 'City', 'name': 'Villenave-d\'Ornon' },
  { '@type': 'AdministrativeArea', 'name': 'Gironde' },
  { '@type': 'AdministrativeArea', 'name': 'Nouvelle-Aquitaine' },
  { '@type': 'Country', 'name': 'France' },
]

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://guyboireau.com/#person',
    name: 'Guy Boireau',
    jobTitle: 'Développeur indépendant, applications métier et automatisation',
