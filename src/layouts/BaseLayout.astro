---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Guy Boireau" />
    <meta name="theme-color" content="#a0493b" />
    <meta name="keywords" content={keywords} />
    <!-- Geo tags for local SEO -->
    <meta name="geo.region" content="FR-33" />
    <meta name="geo.placename" content="Bordeaux" />
    <meta name="geo.position" content="44.8378;-0.5792" />
    <meta name="ICBM" content="44.8378, -0.5792" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Guy Boireau — Applications métier & automatisation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Guy Boireau — Applications métier & automatisation · Bordeaux" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Favicons — sceau gb -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="msapplication-TileColor" content="#a0493b" />

    <!-- Police de marque (préchargement) -->
    <link
      rel="preload"
      href="/fonts/cormorant-garamond.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Sans JavaScript, le contenu s'affiche en position finale (TD-008) -->
    <noscript>
      <style>
        .reveal-fade-up,
        .reveal-fade-left,
        .reveal-fade-right,
        .reveal-scale,
        .stagger-item,
        .hero-animate {
          opacity: 1 !important;
          transform: none !important;
          animation: none !important;
          transition: none !important;
        }
      </style>
    </noscript>

    <!-- Slot pour JSON-LD supplémentaire par page -->
    <slot name="jsonld" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-K2J6DN5X');
    </script>
  </head>
  <body>
    <!-- GTM noscript -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K2J6DN5X" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <slot />

    <!-- Vercel Analytics -->
    <script>
      import { inject } from '@vercel/analytics'
      inject()
    </script>

    <!-- Défilement fluide (Lenis) — chargé dynamiquement, jamais en mouvement réduit -->
    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

      const startLenis = async () => {
        if (prefersReducedMotion.matches) return
        const { default: Lenis } = await import('lenis')
        const lenis = new Lenis({
          duration: 1.05,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        const raf = (time: number) => {
          lenis.raf(time)
          requestAnimationFrame(raf)
        }
        requestAnimationFrame(raf)

        // Coupe le défilement fluide si l'utilisateur active le mouvement réduit en cours de session
        prefersReducedMotion.addEventListener('change', (event) => {
          if (event.matches) lenis.destroy()
        })
      }

      startLenis()
    </script>

    <!-- Scroll Reveal -->
    <script>
      const SELECTOR = '.reveal-fade-up, .reveal-fade-left, .reveal-fade-right, .reveal-scale, .stagger-item'

      // Filet de sécurité : sans IntersectionObserver, tout s'affiche en position finale
      // plutôt que de rester invisible (le contenu est déjà dans le HTML rendu).
      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll(SELECTOR).forEach((el) => el.classList.add('revealed'))
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed')
            }
          })
        },
        { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
      )

      // Décalage progressif entre les éléments d'une même grille (60 à 100 ms)
      const STAGGER_MS = 70
      const STAGGER_MAX = 6

      const applyStagger = () => {
        const groups = new Map<Element, Element[]>()

        document.querySelectorAll('.stagger-item').forEach((el) => {
          const parent = el.parentElement
          if (!parent) return
          const siblings = groups.get(parent) ?? []
          siblings.push(el)
          groups.set(parent, siblings)
        })

        groups.forEach((siblings) => {
          if (siblings.length < 2) return
          siblings.forEach((el, index) => {
            const delay = Math.min(index, STAGGER_MAX) * STAGGER_MS
            ;(el as HTMLElement).style.transitionDelay = `${delay}ms`
          })
        })
      }

      const observe = () => {
        applyStagger()
        document.querySelectorAll(SELECTOR).forEach((el) => observer.observe(el))
      }

      // Scan initial
      observe()
      // Rescan après hydration des islands Astro
      document.addEventListener('astro:page-load', observe)
      window.addEventListener('astro:load', observe)
    </script>
  </body>
</html>
