---
import '../styles/global.css'

export interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  ogType?: string
  keywords?: string
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/og-image.png',
  ogType = 'website',
  keywords = 'application métier bordeaux, automatisation de processus entreprise, traitement documentaire automatisé, développeur indépendant bordeaux, logiciel métier PME, automatisation saisie bordeaux, développeur freelance bordeaux',
} = Astro.props

const ogImageAbsolute = new URL(ogImage, Astro.site).toString()

const sameAs = [
  'https://www.linkedin.com/in/guy-boireau',
  'https://github.com/guyboireau',
  'https://gitlab.com/guyboireau',
]

const address = {
  '@type': 'PostalAddress',
  streetAddress: 'Bordeaux',
  addressLocality: 'Bordeaux',
  addressRegion: 'Nouvelle-Aquitaine',
  postalCode: '33000',
  addressCountry: 'FR',
}

const areaServed = [
  { '@type': 'City', 'name': 'Bordeaux' },
  { '@type': 'City', 'name': 'Mérignac' },
  { '@type': 'City', 'name': 'Pessac' },
  { '@type': 'City', 'name': 'Talence' },
  { '@type': 'City', 'name': 'Villenave-d\'Ornon' },
  { '@type': 'City', 'name': 'Mérignac' },
  { '@type': 'AdministrativeArea', 'name': 'Gironde' },
  { '@type': 'AdministrativeArea', 'name': 'Nouvelle-Aquitaine' },
  { '@type': 'Country', 'name': 'France' },
]

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://guyboireau.com/#person',
    name: 'Guy Boireau',
    jobTitle: 'Développeur indépendant — applications métier & automatisation',
    url: 'https://guyboireau.com',
    email: 'me@guyboireau.com',
    telephone: '+33675751439',
    image: 'https://guyboireau.com/assets/profile.png',
    address,
    sameAs,
    knowsAbout: ['Applications métier', 'Automatisation de processus', 'Traitement documentaire automatisé', 'Facturation électronique', 'React', 'TypeScript', 'NestJS', 'React Native', 'PostgreSQL', 'Supabase'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://guyboireau.com/#business',
    name: 'Guy Boireau — Applications métier & automatisation · Bordeaux',
    alternateName: 'Guy Boireau Développeur Indépendant',
    url: 'https://guyboireau.com',
    telephone: '+33675751439',
    email: 'me@guyboireau.com',
    logo: 'https://guyboireau.com/assets/logo.png',
    image: 'https://guyboireau.com/assets/profile.png',
    description: 'Développeur indépendant à Bordeaux. Applications métier, automatisation de processus et traitement documentaire pour les structures de 5 à 30 salariés. Suivi mensuel dès 79€/mois.',
    address,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 44.8378,
      longitude: -0.5792,
    },
    areaServed,
    priceRange: '€€',
    currenciesAccepted: 'EUR',
    paymentAccepted: 'Virement bancaire, Chèque',
    openingHours: 'Mo-Fr 09:00-18:00',
    taxID: '993 605 542 00014',
    founder: {
      '@type': 'Person',
      '@id': 'https://guyboireau.com/#person',
      name: 'Guy Boireau',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Applications métier, automatisation et présence en ligne',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Applications métier & automatisation', description: 'Application métier sur-mesure, automatisation de processus, interfaces de saisie terrain, espaces de gestion' } },
