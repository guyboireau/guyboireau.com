---
import '../styles/global.css'

export interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  ogType?: string
  keywords?: string
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/og-image.svg',
  ogType = 'website',
  keywords = 'développeur web bordeaux, freelance bordeaux, création site web bordeaux, développeur web freelance, react bordeaux, typescript bordeaux, site web artisan bordeaux',
} = Astro.props

const ogImageAbsolute = new URL(ogImage, Astro.site).toString()

const sameAs = [
  'https://www.linkedin.com/in/guy-boireau',
  'https://github.com/guyboireau',
  'https://gitlab.com/guyboireau',
]

const address = {
  '@type': 'PostalAddress',
  streetAddress: 'Bordeaux',
  addressLocality: 'Bordeaux',
  addressRegion: 'Nouvelle-Aquitaine',
  postalCode: '33000',
  addressCountry: 'FR',
}

const areaServed = [
  { '@type': 'City', 'name': 'Bordeaux' },
  { '@type': 'City', 'name': 'Mérignac' },
  { '@type': 'City', 'name': 'Pessac' },
  { '@type': 'City', 'name': 'Talence' },
  { '@type': 'City', 'name': 'Villenave-d\'Ornon' },
  { '@type': 'City', 'name': 'Mérignac' },
  { '@type': 'AdministrativeArea', 'name': 'Gironde' },
  { '@type': 'AdministrativeArea', 'name': 'Nouvelle-Aquitaine' },
  { '@type': 'Country', 'name': 'France' },
]

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://guyboireau.com/#person',
    name: 'Guy Boireau',
    jobTitle: 'Développeur Web Freelance',
    url: 'https://guyboireau.com',
    email: 'me@guyboireau.com',
    telephone: '+33675751439',
    image: 'https://guyboireau.com/assets/profile.png',
    address,
    sameAs,
    knowsAbout: ['React', 'TypeScript', 'NestJS', 'React Native', 'PostgreSQL', 'Supabase', 'Astro'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://guyboireau.com/#business',
    name: 'Guy Boireau — Développeur Web Freelance Bordeaux',
    alternateName: 'Guy Boireau Développeur Web',
    url: 'https://guyboireau.com',
    telephone: '+33675751439',
    email: 'me@guyboireau.com',
    logo: 'https://guyboireau.com/assets/logo.png',
    image: 'https://guyboireau.com/assets/profile.png',
    description: 'Développeur web freelance à Bordeaux. Création de sites web, applications web et mobiles sur-mesure. Maintenance mensuelle, SEO local. Devis gratuit.',
    address,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 44.8378,
      longitude: -0.5792,
    },
    areaServed,
    priceRange: '€€',
    currenciesAccepted: 'EUR',
    paymentAccepted: 'Virement bancaire, Chèque',
    openingHours: 'Mo-Fr 09:00-18:00',
    taxID: '993 605 542 00014',
    founder: {
      '@type': 'Person',
      '@id': 'https://guyboireau.com/#person',
      name: 'Guy Boireau',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Services de développement web',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Création de site vitrine', description: 'Site web professionnel sur-mesure à partir de 1 000€' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Application web & mobile', description: 'Application métier, marketplace, app iOS/Android à partir de 3 000€' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Maintenance mensuelle', description: 'Hébergement, mises à jour, SEO local à partir de 79€/mois' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Dépannage informatique', description: 'Prise en main à distance, 35€/heure' } },
      ],
    },
    sameAs,
  },
]
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Guy Boireau" />
    <meta name="theme-color" content="#ff6b35" />
    <meta name="keywords" content={keywords} />
    <!-- Geo tags for local SEO -->
    <meta name="geo.region" content="FR-33" />
    <meta name="geo.placename" content="Bordeaux" />
    <meta name="geo.position" content="44.8378;-0.5792" />
    <meta name="ICBM" content="44.8378, -0.5792" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Guy Boireau — Développeur Web Freelance" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Guy Boireau — Développeur Web Freelance Bordeaux" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Slot pour JSON-LD supplémentaire par page -->
    <slot name="jsonld" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-K2J6DN5X');
    </script>
  </head>
  <body>
    <!-- GTM noscript -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K2J6DN5X" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <slot />

    <!-- Vercel Analytics -->
    <script>
      import { inject } from '@vercel/analytics'
      inject()
    </script>

    <!-- Scroll Reveal -->
    <script>
      const SELECTOR = '.reveal-fade-up, .reveal-fade-left, .reveal-fade-right, .reveal-scale, .stagger-item'

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed')
            }
          })
        },
        { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
      )

      const observe = () => {
        document.querySelectorAll(SELECTOR).forEach((el) => observer.observe(el))
      }

      // Scan initial
      observe()
      // Rescan après hydration des islands Astro
      document.addEventListener('astro:page-load', observe)
      window.addEventListener('astro:load', observe)
    </script>
  </body>
</html>
