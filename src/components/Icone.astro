export type NomIcone = keyof typeof ICONES

interface Props {
  nom: NomIcone
  taille?: number
  class?: string
  /** Texte lu par les lecteurs d'écran. Sans lui, l'icône est décorative. */
  label?: string
}

const { nom, taille = 20, class: classe, label } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={classe}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={ICONES[nom]}
/>
