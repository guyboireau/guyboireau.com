---
const year = new Date().getFullYear()
---

<footer class="bg-[#25332b] border-t border-[#374a3f] py-10 text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-3">
          <img src="/assets/logo-seal-cream.svg" alt="Guy Boireau — Agence Web · Bordeaux" width="48" height="48" class="h-12 w-12" />
          <span class="flex flex-col leading-none">
            <span class="font-display text-xl font-semibold text-[#f4ecdd]">Guy Boireau</span>
            <span class="text-[10px] tracking-[0.22em] uppercase text-[#b9ad97] mt-1">Agence Web · Bordeaux</span>
          </span>
        </div>
        <address class="not-italic">
          <p class="text-slate-400 text-sm">
            Développeur Web Freelance<br />
            <span itemprop="addressLocality">Bordeaux</span>, <span itemprop="addressCountry">France</span>
          </p>
          <p class="text-slate-500 text-xs mt-2">SIRET : 993 605 542 00014</p>
        </address>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-slate-200 font-semibold mb-3">Navigation</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-slate-400 hover:text-primary-400 transition-colors text-sm">Accueil</a></li>
          <li><a href="/a-propos" class="text-slate-400 hover:text-primary-400 transition-colors text-sm">À propos</a></li>
          <li><a href="/services" class="text-slate-400 hover:text-primary-400 transition-colors text-sm">Services & Tarifs</a></li>
          <li><a href="/projets" class="text-slate-400 hover:text-primary-400 transition-colors text-sm">Projets</a></li>
          <li><a href="/contact" class="text-slate-400 hover:text-primary-400 transition-colors text-sm">Contact</a></li>
          <li><a href="/mentions-legales" class="text-slate-400 hover:text-primary-400 transition-colors text-sm">Mentions légales</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-slate-200 font-semibold mb-3">Contact</h3>
        <ul class="space-y-2">
          <li>
            <a href="mailto:me@guyboireau.com" class="text-slate-400 hover:text-primary-400 transition-colors text-sm" itemprop="email">
              me@guyboireau.com
            </a>
          </li>
          <li>
            <a href="tel:+33675751439" class="text-slate-400 hover:text-primary-400 transition-colors text-sm" itemprop="telephone">
              06 75 75 14 39
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/guy-boireau" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-primary-400 transition-colors text-sm">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://github.com/guyboireau" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-primary-400 transition-colors text-sm">
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#374a3f] pt-6 text-center">
      <p class="text-[#a99f8c] text-sm">
        © {year} Guy Boireau — Développeur Web Freelance. Tous droits réservés.
      </p>
    </div>
  </div>
</footer>
