---
const year = new Date().getFullYear()

const liensSite = [
  { href: '/', label: 'Accueil' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/services', label: 'Services et tarifs' },
  { href: '/traitement-documentaire', label: 'Traitement documentaire' },
  { href: '/facturation-electronique', label: 'Facturation électronique' },
  { href: '/automatisations', label: 'Automatisations' },
  { href: '/hebergement-exploitation', label: 'Hébergement et suivi' },
  { href: '/projets', label: 'Projets' },
  { href: '/contact', label: 'Contact' },
]

// Sur le vert forêt : crème sourd au repos (7,2:1), crème au survol (11,3:1).
// Le terracotta clair n'atteint que 3,9:1 sur ce vert : pas de terracotta ici.
const lien = 'text-creme-sourd hover:text-creme underline-offset-4 hover:underline text-sm'
---

<footer class="bg-foret py-12 text-creme-sourd">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Identité -->
      <div>
        <div class="flex items-center gap-3 mb-3">
          <img src="/assets/logo-seal-cream.svg" alt="" width="48" height="48" class="h-12 w-12" />
          <span class="flex flex-col leading-none">
            <span class="font-display text-xl font-semibold text-creme">Guy Boireau</span>
            <span class="font-mono text-[13px] text-creme-sourd mt-2">Développeur indépendant, Bordeaux</span>
          </span>
        </div>
        <address class="not-italic">
          <p class="text-creme-sourd text-sm">
            Guy Boireau EI (entrepreneur individuel)<br />
            Bordeaux, France
          </p>
          <p class="font-mono text-creme-sourd text-[13px] mt-2">SIRET 993 605 542 00014</p>
        </address>
      </div>

      <!-- Navigation -->
      <nav aria-label="Pied de page">
        <h2 class="font-mono text-[13px] font-medium uppercase tracking-wider text-creme mb-4">Navigation</h2>
        <ul class="space-y-2">
          {liensSite.map((l) => (
            <li><a href={l.href} class={lien}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h2 class="font-mono text-[13px] font-medium uppercase tracking-wider text-creme mb-4">Contact</h2>
        <ul class="space-y-2">
          <li>
            <a href="mailto:me@guyboireau.com" class={lien}>me@guyboireau.com</a>
          </li>
          <li>
            <a href="tel:+33675751439" class={lien}>06 75 75 14 39</a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/guy-boireau" target="_blank" rel="noopener noreferrer" class={lien}>
              LinkedIn<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/guyboireau" target="_blank" rel="noopener noreferrer" class={lien}>
              GitHub<span class="sr-only"> (nouvel onglet)</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-creme-sourd/30 pt-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p class="text-creme-sourd text-sm">
        © {year} Guy Boireau EI
      </p>
      <nav aria-label="Informations légales">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          <li><a href="/mentions-legales" class={lien}>Mentions légales</a></li>
          <li><a href="/confidentialite" class={lien}>Confidentialité</a></li>
          <li>
            <a href="/cgv" class={lien}>CGV<span class="sr-only"> (conditions générales de vente)</span></a>
          </li>
          <li><a href="/cgv#mediation" class={lien}>Médiation de la consommation</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
