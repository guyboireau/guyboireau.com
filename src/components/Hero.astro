---
import { Image } from 'astro:assets'
import { anneesExperience } from '../data/experience'
import portrait from '../assets/profile.jpg'
---

<section id="hero" class="bg-creme border-b border-ligne pt-28 pb-16 md:pt-36 md:pb-24 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto grid gap-12 md:grid-cols-[minmax(0,1fr)_280px] md:items-center">
    <div>
      <p class="etiquette mb-6">Guy Boireau · développeur indépendant à Bordeaux</p>

      <h1 class="text-4xl md:text-6xl leading-[1.08] mb-6 max-w-3xl">
        Je développe les outils de votre entreprise, puis je les garde en service.
      </h1>

      <p class="text-lg md:text-xl text-encre-2 leading-relaxed mb-10 max-w-2xl">
        Applications métier, automatisations et sites web, pour les PME et les artisans.
        Un seul interlocuteur, du premier appel à l'hébergement en France.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="btn-primary">Me contacter</a>
        <a href="/services" class="btn-secondary">Voir les services et les tarifs</a>
      </div>

      <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-2 font-mono text-[13px] text-encre-2">
        <li>Réponse sous 24 h</li>
        <li><span data-annees-experience>{anneesExperience()}</span> ans d'expérience</li>
        <li>Hébergement en France</li>
      </ul>
    </div>

    <figure class="hidden md:block">
      <Image
        src={portrait}
        alt="Guy Boireau"
        width={280}
        height={280}
        class="w-full h-auto rounded border border-ligne"
        loading="eager"
      />
    </figure>
  </div>
</section>
