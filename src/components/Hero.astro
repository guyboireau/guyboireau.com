---
const particles = Array.from({ length: 15 }, (_, i) => ({
  id: i,
  left: `${Math.round((i * 7 + 3) % 100)}%`,
  size: `${Math.round(2 + (i % 4))}px`,
  duration: `${8 + (i % 7)}s`,
  delay: `${(i * 1.3) % 10}s`,
  opacity: 0.15 + (i % 5) * 0.08,
}))
---

<section id="hero" class="min-h-screen animated-gradient flex items-center justify-center relative overflow-hidden py-20 px-4 sm:px-6 lg:px-8">
  <!-- Background blobs — plan lointain -->
  <div data-parallax="0.18" class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute w-96 h-96 bg-primary-500/10 rounded-full blur-3xl -top-48 -left-48 animate-float"></div>
    <div class="absolute w-96 h-96 bg-primary-600/10 rounded-full blur-3xl -bottom-48 -right-48 animate-float" style="animation-delay:3s"></div>
    <div class="absolute w-64 h-64 bg-[#c17960]/10 rounded-full blur-2xl top-1/3 right-1/4 animate-float" style="animation-delay:5s"></div>
  </div>

  <!-- Particles — plan médian -->
  <div data-parallax="0.34" class="absolute inset-0 overflow-hidden pointer-events-none">
    {particles.map((p) => (
      <div
        class="particle"
        style={`left:${p.left};bottom:-10px;width:${p.size};height:${p.size};animation-duration:${p.duration};animation-delay:${p.delay};opacity:${p.opacity}`}
      />
    ))}
  </div>

  <div data-parallax="0.46" class="relative z-10 text-center max-w-4xl mx-auto">
    <!-- Badge disponibilité -->
    <div class="inline-flex items-center gap-2 bg-green-50 border border-green-200 rounded-full px-4 py-1.5 mb-8 hero-animate hero-animate-delay-1">
      <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
      <span class="text-green-700 text-sm font-medium">Disponible pour de nouveaux projets</span>
    </div>

    <h1 class="font-display text-6xl md:text-8xl font-semibold mb-6 leading-[1.05] tracking-tight">
      <span class="block text-gradient glow-effect hero-animate hero-animate-delay-1">
        Vos process,
      </span>
      <span class="block text-slate-800 hero-animate hero-animate-delay-2">
        enfin outillés
      </span>
    </h1>

    <p class="text-xl text-slate-600 mb-3 hero-animate hero-animate-delay-2 font-medium">
      Développeur indépendant — Bordeaux &amp; toute la France en remote
    </p>
    <p class="text-lg text-slate-500 mb-10 max-w-2xl mx-auto leading-relaxed hero-animate hero-animate-delay-3">
      Applications métier, automatisation de processus et traitement documentaire pour les structures de 5 à 30 salariés. Ce que vos équipes refont à la main chaque semaine, outillé une bonne fois.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center hero-animate hero-animate-delay-4">
      <a href="/contact" class="btn-primary text-lg px-8 py-4 pulse-glow inline-block">
        Parlons de votre projet →
      </a>
      <a href="/services" class="btn-secondary text-lg px-8 py-4 inline-block">
        Voir les offres & tarifs
      </a>
    </div>

    <!-- Social proof -->
    <div class="flex flex-wrap justify-center gap-6 mt-12 hero-animate hero-animate-delay-4">
      <div class="text-center">
        <div class="text-2xl font-bold text-primary-500">3</div>
        <div class="text-xs text-slate-500">ans d'expérience</div>
      </div>
      <div class="w-px h-10 bg-slate-300"></div>
      <div class="text-center">
        <div class="text-2xl font-bold text-primary-500">10+</div>
        <div class="text-xs text-slate-500">projets livrés</div>
      </div>
      <div class="w-px h-10 bg-slate-300"></div>
      <div class="text-center">
        <div class="text-2xl font-bold text-primary-500">24h</div>
        <div class="text-xs text-slate-500">délai de réponse</div>
      </div>
    </div>
  </div>
</section>

<script>
  // Parallaxe multi-plans — desktop uniquement, coupée en mouvement réduit,
  // suspendue dès que la hero sort du viewport.
  const hero = document.getElementById('hero')
  const layers = Array.from(document.querySelectorAll<HTMLElement>('#hero [data-parallax]'))

  if (hero && layers.length > 0) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const desktop = window.matchMedia('(min-width: 768px)')

    let visible = true
    let ticking = false

    const reset = () => {
      layers.forEach((layer) => {
        layer.style.transform = ''
      })
    }

    const update = () => {
      ticking = false
      const offset = window.scrollY
      if (offset > window.innerHeight) return
      layers.forEach((layer) => {
        const factor = Number(layer.dataset.parallax ?? 0)
        layer.style.transform = `translate3d(0, ${(offset * factor).toFixed(1)}px, 0)`
      })
    }

    const onScroll = () => {
      if (!visible || ticking) return
      if (reducedMotion.matches || !desktop.matches) return
      ticking = true
      requestAnimationFrame(update)
    }

    new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? false
      },
      { threshold: 0 }
    ).observe(hero)

    window.addEventListener('scroll', onScroll, { passive: true })

    const onPreferenceChange = () => {
      if (reducedMotion.matches || !desktop.matches) reset()
      else onScroll()
    }

    reducedMotion.addEventListener('change', onPreferenceChange)
    desktop.addEventListener('change', onPreferenceChange)
  }
</script>
