---
import { anneesExperience } from '../data/experience'
import HeroGrid from './HeroGrid.astro'

// Quinze particules. Leurs positions et rythmes sont dans le bloc <style> en
// bas du composant (règles :nth-child), pas en attribut style : la CSP du
// site n'autorise aucun style en ligne, et un <style> de composant reçoit
// son empreinte sha256 au build (security.csp).
const particles = Array.from({ length: 15 }, (_, i) => i)
---

<section id="hero" class="min-h-screen animated-gradient flex items-center justify-center relative overflow-hidden py-20 px-4 sm:px-6 lg:px-8">
  <!-- Maillage de points — plan de fond, chargé seulement sur desktop -->
  <HeroGrid />

  <!-- Background blobs — plan lointain -->
  <div data-parallax="0.18" class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute w-96 h-96 bg-primary-500/10 rounded-full blur-3xl -top-48 -left-48 animate-float"></div>
    <div class="absolute w-96 h-96 bg-primary-600/10 rounded-full blur-3xl -bottom-48 -right-48 animate-float blob-delay-3"></div>
    <div class="absolute w-64 h-64 bg-[#c17960]/10 rounded-full blur-2xl top-1/3 right-1/4 animate-float blob-delay-5"></div>
  </div>

  <!-- Particles — plan médian -->
  <div data-parallax="0.34" class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    {particles.map(() => (
      <div class="particle" />
    ))}
  </div>

  <div data-parallax="0.46" class="relative z-10 text-center max-w-4xl mx-auto">
    <!-- Badge disponibilité -->
    <div class="inline-flex items-center gap-2 bg-green-50 border border-green-200 rounded-full px-4 py-1.5 mb-8 hero-animate hero-animate-delay-1">
      <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse" aria-hidden="true"></span>
      <span class="text-green-700 text-sm font-medium">Disponible pour de nouveaux projets</span>
    </div>

    <h1 class="font-display text-6xl md:text-8xl font-semibold mb-6 leading-[1.05] tracking-tight">
      <span class="block text-gradient glow-effect hero-animate hero-animate-delay-1">
        Vos process,
      </span>
      <span class="block text-slate-800 hero-animate hero-animate-delay-2">
        enfin outillés
      </span>
    </h1>

    <p class="text-xl text-slate-600 mb-3 hero-animate hero-animate-delay-2 font-medium">
      Développeur indépendant — Bordeaux &amp; toute la France en remote
    </p>
    <p class="text-lg text-slate-600 mb-10 max-w-2xl mx-auto leading-relaxed hero-animate hero-animate-delay-3">
      Applications métier, automatisation de processus et traitement documentaire pour les structures de 5 à 30 salariés. Ce que vos équipes refont à la main chaque semaine, outillé une bonne fois.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center hero-animate hero-animate-delay-4">
      <a href="/contact" class="btn-primary text-lg px-8 py-4 pulse-glow inline-block">
        Parlons de votre projet<span aria-hidden="true"> →</span>
      </a>
      <a href="/services" class="btn-secondary text-lg px-8 py-4 inline-block">
        Voir les offres & tarifs
      </a>
    </div>

    <!-- Social proof -->
    <div class="flex flex-wrap justify-center gap-6 mt-12 hero-animate hero-animate-delay-4">
      <div class="text-center">
        <div class="text-2xl font-bold text-primary-500" data-annees-experience>{anneesExperience()}</div>
        <div class="text-xs text-slate-600">ans d'expérience</div>
      </div>
      <div class="w-px h-10 bg-slate-300" aria-hidden="true"></div>
      <div class="text-center">
        <div class="text-2xl font-bold text-primary-500">10+</div>
        <div class="text-xs text-slate-600">projets livrés</div>
      </div>
      <div class="w-px h-10 bg-slate-300" aria-hidden="true"></div>
      <div class="text-center">
        <div class="text-2xl font-bold text-primary-500">24h</div>
        <div class="text-xs text-slate-600">délai de réponse</div>
      </div>
    </div>
  </div>
</section>

<style>
  .blob-delay-3 { animation-delay: 3s; }
  .blob-delay-5 { animation-delay: 5s; }
  /* Mêmes valeurs que l'ancienne formule (i*7+3)%100, 2+i%4, 8+i%7, i*1.3%10,
     0.15+(i%5)*0.08 — figées ici pour tenir sans attribut style. */
  .particle { bottom: -10px; }
  .particle:nth-child(1) { left: 3%; width: 2px; height: 2px; animation-duration: 8s; animation-delay: 0s; opacity: 0.15; }
  .particle:nth-child(2) { left: 10%; width: 3px; height: 3px; animation-duration: 9s; animation-delay: 1.3s; opacity: 0.23; }
  .particle:nth-child(3) { left: 17%; width: 4px; height: 4px; animation-duration: 10s; animation-delay: 2.6s; opacity: 0.31; }
  .particle:nth-child(4) { left: 24%; width: 5px; height: 5px; animation-duration: 11s; animation-delay: 3.9s; opacity: 0.39; }
  .particle:nth-child(5) { left: 31%; width: 2px; height: 2px; animation-duration: 12s; animation-delay: 5.2s; opacity: 0.47; }
  .particle:nth-child(6) { left: 38%; width: 3px; height: 3px; animation-duration: 13s; animation-delay: 6.5s; opacity: 0.15; }
  .particle:nth-child(7) { left: 45%; width: 4px; height: 4px; animation-duration: 14s; animation-delay: 7.8s; opacity: 0.23; }
  .particle:nth-child(8) { left: 52%; width: 5px; height: 5px; animation-duration: 8s; animation-delay: 9.1s; opacity: 0.31; }
  .particle:nth-child(9) { left: 59%; width: 2px; height: 2px; animation-duration: 9s; animation-delay: 0.4s; opacity: 0.39; }
  .particle:nth-child(10) { left: 66%; width: 3px; height: 3px; animation-duration: 10s; animation-delay: 1.7s; opacity: 0.47; }
  .particle:nth-child(11) { left: 73%; width: 4px; height: 4px; animation-duration: 11s; animation-delay: 3s; opacity: 0.15; }
  .particle:nth-child(12) { left: 80%; width: 5px; height: 5px; animation-duration: 12s; animation-delay: 4.3s; opacity: 0.23; }
  .particle:nth-child(13) { left: 87%; width: 2px; height: 2px; animation-duration: 13s; animation-delay: 5.6s; opacity: 0.31; }
  .particle:nth-child(14) { left: 94%; width: 3px; height: 3px; animation-duration: 14s; animation-delay: 6.9s; opacity: 0.39; }
  .particle:nth-child(15) { left: 1%; width: 4px; height: 4px; animation-duration: 8s; animation-delay: 8.2s; opacity: 0.47; }
</style>

<script>
  // Parallaxe multi-plans — desktop uniquement, coupée en mouvement réduit,
  // suspendue dès que la hero sort du viewport.
  const hero = document.getElementById('hero')
  const layers = Array.from(document.querySelectorAll<HTMLElement>('#hero [data-parallax]'))

  if (hero && layers.length > 0) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const desktop = window.matchMedia('(min-width: 768px)')

    let visible = true
    let ticking = false

    const reset = () => {
      layers.forEach((layer) => {
        layer.style.transform = ''
      })
    }

    const update = () => {
      ticking = false
      const offset = window.scrollY
      if (offset > window.innerHeight) return
      layers.forEach((layer) => {
        const factor = Number(layer.dataset.parallax ?? 0)
        layer.style.transform = `translate3d(0, ${(offset * factor).toFixed(1)}px, 0)`
      })
    }

    const onScroll = () => {
      if (!visible || ticking) return
      if (reducedMotion.matches || !desktop.matches) return
      ticking = true
      requestAnimationFrame(update)
    }

    new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? false
      },
      { threshold: 0 }
    ).observe(hero)

    window.addEventListener('scroll', onScroll, { passive: true })

    const onPreferenceChange = () => {
      if (reducedMotion.matches || !desktop.matches) reset()
      else onScroll()
    }

    reducedMotion.addEventListener('change', onPreferenceChange)
    desktop.addEventListener('change', onPreferenceChange)
  }
</script>
