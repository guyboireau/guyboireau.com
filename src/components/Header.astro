---
const currentPath = Astro.url.pathname

const expertises = [
  { href: '/traitement-documentaire', label: 'Traitement documentaire' },
  { href: '/facturation-electronique', label: 'Facturation électronique' },
  { href: '/automatisations', label: 'Automatisations IA' },
]

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/services', label: 'Services & Tarifs' },
  { href: '/projets', label: 'Projets' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/contact', label: 'Contact' },
]

const isExpertise = expertises.some((link) => link.href === currentPath)
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="flex items-center gap-2.5 group" aria-label="Guy Boireau — Accueil">
        <img
          src="/assets/logo-seal.svg"
          alt="Guy Boireau — Applications métier & automatisation · Bordeaux"
          width="44"
          height="44"
          class="h-11 w-11 transition-transform duration-500 ease-out group-hover:rotate-[24deg]"
        />
        <span class="hidden sm:flex flex-col leading-none">
          <span class="font-display text-2xl font-semibold text-primary-600">Guy Boireau</span>
          <span class="hidden lg:block text-[10px] tracking-[0.14em] uppercase text-slate-500 mt-1 whitespace-nowrap">Applications métier &amp; automatisation · Bordeaux</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center space-x-6 lg:space-x-8">
        <details id="expertises-menu" class="relative">
          <summary
            class={`list-none cursor-pointer transition-colors duration-300 font-medium flex items-center gap-1 ${
              isExpertise ? 'text-primary-500' : 'text-slate-600 hover:text-primary-500'
            }`}
          >
            Expertises
            <span class="text-xs" aria-hidden="true">▾</span>
          </summary>
          <div class="absolute left-0 top-full mt-3 w-64 bg-white border border-slate-200 rounded-xl shadow-lg p-2">
            {expertises.map((link) => (
              <a
                href={link.href}
                class={`block px-3 py-2 rounded-lg text-sm transition-colors ${
                  currentPath === link.href
                    ? 'text-primary-500 bg-primary-50'
                    : 'text-slate-700 hover:text-primary-500 hover:bg-slate-50'
                }`}
              >
                {link.label}
              </a>
            ))}
          </div>
        </details>
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`transition-colors duration-300 font-medium ${
              currentPath === link.href
                ? 'text-primary-500'
                : 'text-slate-600 hover:text-primary-500'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a href="/contact" class="btn-primary text-sm px-5 py-2">
          Devis gratuit
        </a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-slate-600 hover:text-primary-500 transition-colors p-2"
        aria-label="Menu"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white border-b border-slate-200 shadow-md mx-0 p-4 space-y-2"
  >
    <p class="px-3 pt-1 pb-1 text-[10px] tracking-[0.18em] uppercase text-slate-400">Expertises</p>
    {expertises.map((link) => (
      <a
        href={link.href}
        class={`block py-2 px-3 rounded-lg transition-colors font-medium ${
          currentPath === link.href
            ? 'text-primary-500 bg-primary-50'
            : 'text-slate-700 hover:text-primary-500 hover:bg-slate-50'
        }`}
      >
        {link.label}
      </a>
    ))}
    <p class="px-3 pt-3 pb-1 text-[10px] tracking-[0.18em] uppercase text-slate-400">Navigation</p>
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block py-2 px-3 rounded-lg transition-colors font-medium ${
          currentPath === link.href
            ? 'text-primary-500 bg-primary-50'
            : 'text-slate-700 hover:text-primary-500 hover:bg-slate-50'
        }`}
      >
        {link.label}
      </a>
    ))}
    <a href="/contact" class="btn-primary block text-center text-sm mt-2">
      Devis gratuit
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')
  const mobileBtn = document.getElementById('mobile-menu-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const iconOpen = document.getElementById('icon-open')
  const iconClose = document.getElementById('icon-close')

  // Scroll effect — add white bg + shadow on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('bg-white', 'shadow-sm', 'border-b', 'border-slate-200')
    } else {
      header?.classList.remove('bg-white', 'shadow-sm', 'border-b', 'border-slate-200')
    }
  })

  // Referme le menu Expertises au clic extérieur ou à Échap
  const expertisesMenu = document.getElementById('expertises-menu') as HTMLDetailsElement | null

  document.addEventListener('click', (event) => {
    if (!expertisesMenu?.open) return
    if (!expertisesMenu.contains(event.target as Node)) {
      expertisesMenu.open = false
    }
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && expertisesMenu?.open) {
      expertisesMenu.open = false
    }
  })

  // Mobile menu toggle
  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden')
    mobileMenu?.classList.toggle('hidden', isOpen)
    iconOpen?.classList.toggle('hidden', !isOpen)
    iconClose?.classList.toggle('hidden', isOpen)
  })
</script>
