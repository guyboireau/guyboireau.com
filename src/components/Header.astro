---
const currentPath = Astro.url.pathname

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/services', label: 'Services & Tarifs' },
  { href: '/projets', label: 'Projets' },
  { href: '/contact', label: 'Contact' },
]
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="flex items-center gap-3">
        <img src="/assets/logo.png" alt="Guy Boireau" class="h-10 w-auto" />
        <span class="text-xl font-bold text-gradient hidden sm:inline">Guy Boireau</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center space-x-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`transition-colors duration-300 ${
              currentPath === link.href
                ? 'text-primary-400 font-medium'
                : 'text-slate-300 hover:text-primary-400'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a href="/contact" class="btn-primary text-sm px-5 py-2">
          Devis gratuit
        </a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-slate-300 hover:text-primary-400 transition-colors p-2"
        aria-label="Menu"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden glass-card mx-4 mb-4 p-4 space-y-3"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block py-2 px-3 rounded-lg transition-colors ${
          currentPath === link.href
            ? 'text-primary-400 bg-primary-500/10'
            : 'text-slate-300 hover:text-primary-400 hover:bg-white/5'
        }`}
      >
        {link.label}
      </a>
    ))}
    <a href="/contact" class="btn-primary block text-center text-sm">
      Devis gratuit
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')
  const mobileBtn = document.getElementById('mobile-menu-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const iconOpen = document.getElementById('icon-open')
  const iconClose = document.getElementById('icon-close')

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('glass-card', 'shadow-xl')
    } else {
      header?.classList.remove('glass-card', 'shadow-xl')
    }
  })

  // Mobile menu toggle
  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden')
    mobileMenu?.classList.toggle('hidden', isOpen)
    iconOpen?.classList.toggle('hidden', !isOpen)
    iconClose?.classList.toggle('hidden', isOpen)
  })
</script>
