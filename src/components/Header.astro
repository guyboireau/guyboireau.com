---
import Icone from './Icone.astro'

// Au build, les pages ont une barre finale (/services/) : sans normalisation,
// aucun lien n'était jamais reconnu comme la page courante.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'

const expertises = [
  { href: '/traitement-documentaire', label: 'Traitement documentaire' },
  { href: '/facturation-electronique', label: 'Facturation électronique' },
  { href: '/automatisations', label: 'Automatisations' },
  { href: '/hebergement-exploitation', label: 'Hébergement et suivi' },
]

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/services', label: 'Services et tarifs' },
  { href: '/projets', label: 'Projets' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/contact', label: 'Contact' },
]

const isExpertise = expertises.some((link) => link.href === currentPath)
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-papier border-b border-ligne">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="flex items-center gap-2.5 group" aria-label="Guy Boireau, accueil">
        <img
          src="/assets/logo-seal.svg"
          alt=""
          width="44"
          height="44"
          class="h-11 w-11"
        />
        <span class="hidden sm:flex flex-col leading-none">
          <span class="font-display text-2xl font-semibold text-primary-600">Guy Boireau</span>
          <span class="hidden lg:block font-mono text-[13px] text-encre-3 mt-1 whitespace-nowrap">Développeur indépendant, Bordeaux</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-6 whitespace-nowrap" aria-label="Menu principal">
        <details id="expertises-menu" class="relative">
          <summary
            class={`list-none cursor-pointer transition-colors duration-300 font-medium flex items-center gap-1 ${
              isExpertise ? 'text-primary-700' : 'text-encre-2 hover:text-primary-700'
            }`}
          >
            Expertises
            <Icone nom="chevron-down" taille={16} />
          </summary>
          <div class="absolute left-0 top-full mt-3 w-64 bg-papier border border-ligne rounded p-2">
            {expertises.map((link) => (
              <a
                href={link.href}
                aria-current={currentPath === link.href ? 'page' : undefined}
                class={`block px-3 py-2 rounded text-sm transition-colors ${
                  currentPath === link.href
                    ? 'text-primary-700 bg-creme'
                    : 'text-encre-2 hover:text-primary-700 hover:bg-creme'
                }`}
              >
                {link.label}
              </a>
            ))}
          </div>
        </details>
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={currentPath === link.href ? 'page' : undefined}
            class={`transition-colors font-medium underline-offset-8 hover:underline ${
              currentPath === link.href
                ? 'text-primary-700'
                : 'text-encre-2 hover:text-primary-700'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a href="/contact" class="btn-primary text-sm px-4 py-2">
          Me contacter
        </a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden text-encre-2 hover:text-primary-700 transition-colors p-2"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="icon-open"><Icone nom="menu" taille={24} /></span>
        <span id="icon-close" class="hidden"><Icone nom="x" taille={24} /></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    aria-label="Menu principal"
    class="hidden lg:hidden bg-papier border-b border-ligne mx-0 p-4 space-y-2"
  >
    <p class="etiquette px-3 pt-1 pb-1">Expertises</p>
    {expertises.map((link) => (
      <a
        href={link.href}
        aria-current={currentPath === link.href ? 'page' : undefined}
        class={`block py-2 px-3 rounded transition-colors font-medium ${
          currentPath === link.href
            ? 'text-primary-700 bg-creme'
            : 'text-encre-2 hover:text-primary-700 hover:bg-creme'
        }`}
      >
        {link.label}
      </a>
    ))}
    <p class="etiquette px-3 pt-3 pb-1">Navigation</p>
    {navLinks.map((link) => (
      <a
        href={link.href}
        aria-current={currentPath === link.href ? 'page' : undefined}
        class={`block py-2 px-3 rounded transition-colors font-medium ${
          currentPath === link.href
            ? 'text-primary-700 bg-creme'
            : 'text-encre-2 hover:text-primary-700 hover:bg-creme'
        }`}
      >
        {link.label}
      </a>
    ))}
    <a href="/contact" class="btn-primary w-full text-sm mt-2">
      Me contacter
    </a>
  </nav>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const iconOpen = document.getElementById('icon-open')
  const iconClose = document.getElementById('icon-close')

  // Referme le menu Expertises au clic extérieur ou à Échap
  const expertisesMenu = document.getElementById('expertises-menu') as HTMLDetailsElement | null

  document.addEventListener('click', (event) => {
    if (!expertisesMenu?.open) return
    if (!expertisesMenu.contains(event.target as Node)) {
      expertisesMenu.open = false
    }
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && expertisesMenu?.open) {
      expertisesMenu.open = false
    }
  })

  // Menu mobile : l'état ouvert/fermé est exposé aux technologies d'assistance
  // (aria-expanded), et Échap le referme en rendant le focus au bouton.
  const setMobileMenu = (open: boolean) => {
    mobileMenu?.classList.toggle('hidden', !open)
    iconOpen?.classList.toggle('hidden', open)
    iconClose?.classList.toggle('hidden', !open)
    mobileBtn?.setAttribute('aria-expanded', String(open))
  }

  mobileBtn?.addEventListener('click', () => {
    setMobileMenu(mobileMenu?.classList.contains('hidden') ?? false)
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      setMobileMenu(false)
      mobileBtn?.focus()
    }
  })
</script>
