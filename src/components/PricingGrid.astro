---
import { getSupabaseServer } from '../lib/supabase.server';

interface PricingFeature {
  name: string;
  included: boolean;
}

interface PricingTier {
  id: string;
  name: string;
  price: number;
  currency: string;
  description: string;
  features: PricingFeature[];
  highlighted: boolean;
  ctaLabel: string;
}

const supabase = getSupabaseServer();
let tiers: PricingTier[] = [];
let fetchError: string | null = null;

if (supabase) {
  const { data, error } = await supabase
    .from('pricing_tiers')
    .select('*')
    .order('price', { ascending: true });

  if (error) {
    fetchError = error.message;
  } else {
    tiers = (data ?? []).map((raw: Record<string, unknown>): PricingTier => ({
      id: String(raw.id ?? ''),
      name: String(raw.name ?? ''),
      price: Number(raw.price ?? 0),
      currency: String(raw.currency ?? 'EUR'),
      description: String(raw.description ?? ''),
      features: Array.isArray(raw.features)
        ? (raw.features as Record<string, unknown>[]).map((f) => ({
            name: String(f.name ?? ''),
            included: Boolean(f.included),
          }))
        : [],
      highlighted: Boolean(raw.highlighted),
      ctaLabel: String(raw.cta_label ?? 'Choisir'),
    }));
  }
}
---

{fetchError && (
  <div class="rounded-lg border border-red-200 bg-red-50 p-6 text-red-800" role="alert">
    <p class="font-semibold">Impossible de charger les tarifs</p>
    <p class="text-sm">{fetchError}</p>
  </div>
)}

{tiers.length > 0 && (
  <section class="py-12" aria-labelledby="pricing-heading">
    <h2 id="pricing-heading" class="sr-only">Grille tarifaire</h2>

    <div class="grid gap-8 md:grid-cols-3">
      {tiers.map((tier) => {
        const formattedPrice = new Intl.NumberFormat('fr-FR', {
          style: 'currency',
          currency: tier.currency,
          minimumFractionDigits: 0,
          maximumFractionDigits: 2,
        }).format(tier.price);

        const contactUrl = `/contact?forfait=${encodeURIComponent(tier.id)}&nom=${encodeURIComponent(tier.name)}`;

        return (
          <article
            class:list={[
              'relative flex flex-col rounded-2xl border p-8 shadow-sm',
              tier.highlighted
                ? 'border-indigo-600 bg-indigo-50 ring-1 ring-indigo-600'
                : 'border-gray-200 bg-white',
            ]}
          >
            {tier.highlighted && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-indigo-600 px-3 py-1 text-xs font-medium text-white">
                Recommandé
              </span>
            )}

            <h3 class="text-lg font-semibold text-gray-900">{tier.name}</h3>
            <p class="mt-2 text-sm text-gray-600">{tier.description}</p>

            <p class="mt-4 flex items-baseline">
              <span class="text-4xl font-bold tracking-tight text-gray-900">
                {formattedPrice}
              </span>
              <span class="ml-1 text-sm font-semibold text-gray-600">/ projet</span>
            </p>

            <ul class="mt-6 flex-1 space-y-4">
              {tier.features.map((feature, index) => (
                <li class="flex items-start" data-index={index}>
                  <span
                    class:list={[
                      'mr-3 flex-shrink-0',
                      feature.included ? 'text-indigo-600' : 'text-gray-400',
                    ]}
                    aria-hidden="true"
                  >
                    {feature.included ? '✓' : '—'}
                  </span>
                  <span
                    class:list={[
                      'text-sm',
                      feature.included ? 'text-gray-700' : 'text-gray-400',
                    ]}
                  >
                    {feature.name}
                  </span>
                </li>
              ))}
            </ul>

            <a
              href={contactUrl}
              class:list={[
                'mt-8 block w-full rounded-lg px-4 py-3 text-center text-sm font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2',
                tier.highlighted
                  ? 'bg-indigo-600 text-white hover:bg-indigo-700'
                  : 'bg-gray-900 text-white hover:bg-gray-800',
              ]}
            >
              {tier.ctaLabel}
            </a>
          </article>
        );
      })}
    </div>
  </section>
)}
