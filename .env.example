# Supabase (publiques — exposées au navigateur)
PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Assistant — lues par src/pages/api/chat.ts (serveur uniquement). LES TROIS SONT
# OBLIGATOIRES. Le site déclare que les messages vont chez Mistral AI (UE) par le
# relais LiteLLM du VPS : le SDK parle le protocole Anthropic, mais vise le relais,
# qui route le groupe CHAT_MODEL vers Mistral AI. S'il en manque une (ou si
# ANTHROPIC_BASE_URL vise anthropic.com), /api/chat répond 503 et ne contacte
# aucun fournisseur ; le chat renvoie au formulaire de contact.
ANTHROPIC_API_KEY=cle_du_relais_litellm
ANTHROPIC_BASE_URL=http://127.0.0.1:4000
CHAT_MODEL=assistant-site

# Resend — lue par src/pages/api/contact.ts (serveur uniquement)
# Sans elle, le formulaire de contact renvoie une 500 : « RESEND_API_KEY manquante »
RESEND_API_KEY=re_your_resend_api_key
