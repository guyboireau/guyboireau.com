# Assistant — lues par src/pages/api/chat.ts (serveur uniquement). LES TROIS SONT
# OBLIGATOIRES. Le site déclare que les messages vont chez Mistral AI (UE) par le
# relais LiteLLM du VPS : le SDK parle le protocole Anthropic, mais vise le relais,
# qui route le groupe CHAT_MODEL vers Mistral AI. S'il en manque une (ou si
# ANTHROPIC_BASE_URL vise anthropic.com), /api/chat répond 503 et ne contacte
# aucun fournisseur ; le chat renvoie au formulaire de contact.
ANTHROPIC_API_KEY=cle_du_relais_litellm
ANTHROPIC_BASE_URL=http://127.0.0.1:4000
CHAT_MODEL=assistant-site

# Scaleway Transactional Email — lues par src/pages/api/contact.ts (serveur uniquement).
# Application IAM « guyboireau-site » du projet Scaleway « guyboireau » : envoi seul,
# limitée à l'IP du VPS. Sans elles, l'email ne part pas (la demande reste dans le CRM).
SCW_SECRET_KEY=
SCW_PROJECT_ID=

# CRM (appli agent-freelance, pile Supabase du VPS) — lues par src/lib/crm.ts,
# serveur uniquement. Rôle Postgres site_web : dépôt des demandes de contact et
# lecture des vues publiques (avis, disponibilité), rien d'autre. Sans elles,
# le formulaire n'envoie que l'email et les îlots retombent sur leur repli.
# En production : CRM_URL=http://127.0.0.1:8003 (la pile, sur la même machine).
CRM_URL=
CRM_APIKEY=
CRM_JWT=
